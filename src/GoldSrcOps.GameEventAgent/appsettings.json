{
  "GameEventAgent": {
    "QueuePath": "data/game-event-agent.db",
    "QueueCapacity": 10000,
    "DatabaseBusyTimeoutSeconds": 5,
    "Delivery": {
      "Enabled": false,
      "DispatchIntervalSeconds": 1,
      "LeaseSeconds": 30,
      "BatchSize": 20,
      "MaximumAttempts": 12,
      "MaximumEventAgeDays": 30,
      "RetryBaseSeconds": 1,
      "RetryMaximumSeconds": 300,
      "RequestTimeoutSeconds": 10,
      "OAuth": {
        "Scope": "ingest:game-events",
        "RefreshSkewSeconds": 60
      }
    }
  }
}
