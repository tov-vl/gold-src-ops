{
  "Polling": {
    "Enabled": true,
    "LoopDelaySeconds": 5,
    "QueryTimeoutMilliseconds": 3000,
    "BatchSize": 50,
    "IncidentFailureThreshold": 3
  },
  "CommandDispatcher": {
    "Enabled": true,
    "LoopDelayMilliseconds": 500,
    "MaxConcurrency": 4,
    "InterruptedAfterSeconds": 30,
    "RecoveryIntervalSeconds": 30
  },
  "SnapshotRetention": {
    "Enabled": true,
    "RetentionDays": 30,
    "CleanupIntervalSeconds": 300,
    "BatchSize": 1000
  },
  "AlertDelivery": {
    "Enabled": false,
    "LoopDelayMilliseconds": 500,
    "MaxConcurrency": 4,
    "ClaimTimeoutSeconds": 30,
    "RecoveryIntervalSeconds": 30,
    "RequestTimeoutSeconds": 10,
    "MaxAttempts": 8,
    "BaseRetryDelaySeconds": 5,
    "MaximumRetryDelaySeconds": 300,
    "MetricsIntervalSeconds": 30,
    "ProcessedRetentionDays": 30,
    "CleanupIntervalSeconds": 300,
    "CleanupBatchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
