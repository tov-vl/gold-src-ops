@inherits LayoutComponentBase
@inject WebAuthenticationState AuthenticationState

<div class="site-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="GoldSrcOps home">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            <span>GoldSrcOps</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Status</NavLink>
            <AuthorizeView Policy="@WebSecurity.ReaderPolicy">
                <Authorized>
                    <NavLink href="/operator/servers">Servers</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="session-actions">
            @if (AuthenticationState.Enabled)
            {
                <AuthorizeView>
                    <Authorized Context="authentication">
                        <span class="session-name">@GetDisplayName(authentication.User)</span>
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button class="session-button" type="submit">Sign out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="session-button" href="/auth/login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            }
            else
            {
                <span class="surface-label">Public status</span>
            }
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer>
        <span>GoldSrc fleet monitoring</span>
        <span>All times shown in UTC</span>
    </footer>
</div>

@code {
    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.Identity?.Name ?? "Signed in";
}
