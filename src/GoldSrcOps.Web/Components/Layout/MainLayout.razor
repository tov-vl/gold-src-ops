@inherits LayoutComponentBase
@inject WebAuthenticationState AuthenticationState
@inject NavigationManager Navigation

<div class="site-shell" lang="@Chrome.Code">
    @if (IsPublic)
    {
        <a class="skip-link" href="@SkipTarget">@Chrome["SkipToContent"]</a>
    }
    <header class="topbar">
        <a class="brand" href="@Text.Link("/")" aria-label="@Chrome["HomeLabel"]">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            <span>GoldSrcOps</span>
        </a>
        <nav class="primary-nav" aria-label="@Chrome["PrimaryNavigation"]">
            <NavLink href="@Text.Link("/")" Match="NavLinkMatch.All">@Chrome["StatusNav"]</NavLink>
            <NavLink href="@Text.Link("/play")" lang="@Text.Code">@Text["PlayNav"]</NavLink>
            <NavLink href="@Text.Link("/leaderboard")" lang="@Text.Code">@Text["TopNav"]</NavLink>
            <AuthorizeView Policy="@WebSecurity.ReaderPolicy">
                <Authorized>
                    <NavLink href="/operator/servers">Servers</NavLink>
                    <NavLink href="/operator/activity">Activity</NavLink>
                    <NavLink href="/operator/incidents">Incidents</NavLink>
                    <NavLink href="/operator/alert-delivery">Delivery</NavLink>
                    <NavLink href="/operator/dead-letters">Dead letters</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="session-actions">
            @if (AuthenticationState.Enabled)
            {
                <AuthorizeView>
                    <Authorized Context="authentication">
                        <span class="session-name">@GetDisplayName(authentication.User)</span>
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button class="session-button" type="submit">@Chrome["SignOut"]</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="session-button" href="/auth/login">@Chrome["SignIn"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            }
            else
            {
                <span class="surface-label">@Chrome["PublicStatus"]</span>
            }
        </div>
    </header>

    <main id="main-content" tabindex="-1">
        @Body
    </main>

    <footer>
        <span>@Chrome["FleetFooter"]</span>
        <span>@Chrome["UtcFooter"]</span>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "lang")]
    private string? Language { get; set; }

    private PublicPageText Text => PublicPageText.For(Language);

    private string SkipTarget
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            var bounded = query.All(pair => pair.Value.Count == 1 && (pair.Key.ToLowerInvariant() switch
            {
                "lang" => pair.Value[0]?.ToLowerInvariant() is "ru" or "en",
                "range" => pair.Value[0] is "24h" or "7d",
                _ => false
            }));
            var fallback = uri.AbsolutePath;
            if (fallback == "/" && query.TryGetValue("range", out var ranges) && ranges.FirstOrDefault() == "7d")
            {
                fallback = "/?range=7d";
            }

            return (bounded ? uri.PathAndQuery : Text.Link(fallback)) + "#main-content";
        }
    }

    private bool IsPublic => new Uri(Navigation.Uri).AbsolutePath is "/" or "/play" or "/leaderboard";

    private PublicPageText Chrome => IsPublic ? Text : PublicPageText.For("en");

    private string GetDisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.Identity?.Name ?? Chrome["SignedIn"];
}
