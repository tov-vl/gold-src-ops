@page "/operator/servers/{ServerId:guid}/credentials"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = WebSecurity.ReaderPolicy)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IReaderApiClient ReaderApiClient
@inject OperatorRconCredentialConfirmationStore Confirmations
@inject ILogger<ServerCredentials> Logger

<PageTitle>@(_server is null ? "RCON credential" : $"RCON credential for {_server.Name}") | GoldSrcOps</PageTitle>

<div class="credentials-page">
    <a class="back-link" href="@($"/operator/servers/{ServerId:D}")">Back to server status</a>

    @if (_loadFailed)
    {
        <section class="load-state" role="alert">
            <h1>Credential metadata is unavailable</h1>
            <p>The API did not return a usable Reader snapshot.</p>
        </section>
    }
    else if (_notFound)
    {
        <section class="load-state">
            <h1>Server not found</h1>
            <p>The requested server is not present in the Reader inventory.</p>
        </section>
    }
    else if (_server is not null)
    {
        <header class="credentials-heading">
            <div>
                <p class="eyebrow">Credential boundary</p>
                <h1>@_server.Name</h1>
                <p class="target">RCON binding metadata</p>
            </div>
            <p>Inspect whether an RCON secret is bound. Secret values and the current alias are never returned.</p>
        </header>

        <ServerSectionNav ServerId="@ServerId" />

        @if (GetResultMessage() is { } resultMessage)
        {
            <section class="result-state @GetResultClass()" role="alert">
                <strong>@resultMessage.Title</strong>
                <p>@resultMessage.Detail</p>
            </section>
        }

        <dl class="credential-summary" aria-label="Current RCON credential metadata">
            <div>
                <dt>Binding</dt>
                <dd class="@(_credential is null ? "state-missing" : "state-configured")">
                    @(_credential is null ? "Not configured" : "Configured")
                </dd>
            </div>
            <div>
                <dt>Credential revision</dt>
                <dd>@(_credential?.Revision.ToString(CultureInfo.InvariantCulture) ?? "Not created")</dd>
            </div>
            <div>
                <dt>Server revision</dt>
                <dd>@_server.Revision</dd>
            </div>
            <div>
                <dt>Created</dt>
                <dd>@FormatTimestamp(_credential?.CreatedAtUtc)</dd>
            </div>
            <div>
                <dt>Last rebound</dt>
                <dd>@FormatTimestamp(_credential?.UpdatedAtUtc)</dd>
            </div>
            <div>
                <dt>Stored value</dt>
                <dd>Reference only</dd>
            </div>
        </dl>

        <section class="security-boundary" aria-labelledby="credential-boundary-title">
            <p class="eyebrow">Secret handling</p>
            <h2 id="credential-boundary-title">The password stays outside GoldSrcOps data</h2>
            <p>
                Enter only the deployment alias whose value is provisioned separately under the dedicated
                RCON secret namespace. Neither the password nor an existing alias can be read from this page.
            </p>
        </section>

        <AuthorizeView Policy="@WebSecurity.OperatorPolicy">
            <Authorized>
                @if (_server.IsEnabled)
                {
                    <section class="locked-state" aria-labelledby="credential-locked-title">
                        <p class="eyebrow">Change locked</p>
                        <h2 id="credential-locked-title">Pause monitoring before rebinding</h2>
                        <p>The API also rejects the change if a command is pending or running.</p>
                        <a href="@($"/operator/servers/{ServerId:D}/monitoring")">Manage monitoring</a>
                    </section>
                }
                else if (_draft is not null && _confirmationToken is not null)
                {
                    <section class="review-section" aria-labelledby="credential-review-title">
                        <div class="section-heading">
                            <p class="eyebrow">Review</p>
                            <h2 id="credential-review-title">Confirm RCON credential binding</h2>
                        </div>

                        <dl class="review-summary">
                            <div>
                                <dt>Secret alias</dt>
                                <dd><code>@_draft.SecretAlias</code></dd>
                            </div>
                            <div>
                                <dt>Expected credential revision</dt>
                                <dd>@_draft.ExpectedCredentialRevision</dd>
                            </div>
                            <div>
                                <dt>Expected server revision</dt>
                                <dd>@_draft.ExpectedServerRevision</dd>
                            </div>
                            <div>
                                <dt>Monitoring</dt>
                                <dd>Remains paused</dd>
                            </div>
                            <div>
                                <dt>Incomplete commands</dt>
                                <dd>Checked on submit</dd>
                            </div>
                            <div>
                                <dt>Raw secret</dt>
                                <dd>Not submitted</dd>
                            </div>
                        </dl>

                        <form class="credential-confirmation"
                              method="post"
                              action="@($"/operator/servers/{ServerId:D}/credentials/apply")">
                            <AntiforgeryToken />
                            <input type="hidden" name="ConfirmationToken" value="@_confirmationToken" />
                            <label class="confirmation-field" for="credential-confirmed">
                                <input id="credential-confirmed"
                                       type="checkbox"
                                       name="Confirmed"
                                       value="true" />
                                <span>
                                    I verified the alias and provisioned its secret separately. I will inspect
                                    current metadata before retrying an uncertain submission.
                                </span>
                            </label>
                            <div class="form-actions">
                                <button type="submit">Bind credential</button>
                                <a href="@($"/operator/servers/{ServerId:D}/credentials")">Discard review</a>
                            </div>
                        </form>
                    </section>
                }
                else
                {
                    <section class="edit-section" aria-labelledby="credential-edit-title">
                        <div class="section-heading">
                            <p class="eyebrow">Bind or rotate</p>
                            <h2 id="credential-edit-title">RCON secret alias</h2>
                        </div>

                        <EditForm Context="editContext"
                                  FormName="rcon-credential"
                                  Model="Model"
                                  OnValidSubmit="PrepareUpdateAsync"
                                  class="credential-form">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />
                            <input type="hidden"
                                   name="Model.ExpectedServerRevision"
                                   value="@Model!.ExpectedServerRevision" />
                            <input type="hidden"
                                   name="Model.ExpectedCredentialRevision"
                                   value="@Model.ExpectedCredentialRevision" />

                            <div class="form-field">
                                <label for="credential-alias">Secret alias</label>
                                <InputText id="credential-alias"
                                           @bind-Value="Model.SecretAlias"
                                           maxlength="128"
                                           autocomplete="off"
                                           spellcheck="false" />
                                <ValidationMessage For="@(() => Model.SecretAlias)" />
                                <p>
                                    Use letters, digits, dots, underscores, or hyphens. Do not paste the RCON
                                    password.
                                </p>
                            </div>

                            <div class="form-actions">
                                <button type="submit">Review binding</button>
                                <a href="@($"/operator/servers/{ServerId:D}")">Cancel</a>
                            </div>
                        </EditForm>
                    </section>
                }
            </Authorized>
            <NotAuthorized>
                <section class="role-state">
                    <p class="eyebrow">Read-only session</p>
                    <h2>Operator role required</h2>
                    <p>Your account can inspect credential metadata but cannot bind or rotate the alias.</p>
                </section>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    [Parameter]
    public Guid ServerId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "result")]
    public string? Result { get; set; }

    [SupplyParameterFromForm(FormName = "rcon-credential")]
    private CredentialFormModel? Model { get; set; }

    private ServerResponse? _server;
    private ServerCredentialResponse? _credential;
    private OperatorRconCredentialDraft? _draft;
    private string? _confirmationToken;
    private bool _loadFailed;
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        _loadFailed = false;
        _notFound = false;
        _server = null;
        _credential = null;
        _draft = null;
        _confirmationToken = null;

        try
        {
            var serverTask = ReaderApiClient.GetServerAsync(ServerId);
            var credentialsTask = ReaderApiClient.GetServerCredentialsAsync(ServerId);
            await Task.WhenAll(serverTask, credentialsTask);

            _server = await serverTask;
            var credentials = await credentialsTask;
            _notFound = _server is null || credentials is null;
            if (!_notFound)
            {
                _credential = credentials!.SingleOrDefault(credential =>
                    string.Equals(credential.Kind, "RconPassword", StringComparison.Ordinal));
                Model ??= CredentialFormModel.From(_server!, _credential);
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or InvalidDataException)
        {
            Logger.LogWarning(
                exception,
                "Unable to load credential metadata for server {ServerId}.",
                ServerId);
            _loadFailed = true;
        }
    }

    private async Task PrepareUpdateAsync()
    {
        if (_server is null || _server.IsEnabled)
        {
            Result = "monitoring-enabled";
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authenticationState.User.IsInRole(WebSecurity.OperatorRole))
        {
            return;
        }

        var subject = WebSecurity.GetSubject(authenticationState.User);
        if (subject is null)
        {
            Result = "confirmation-unavailable";
            return;
        }

        _draft = new OperatorRconCredentialDraft(
            ServerId,
            Model!.ExpectedServerRevision,
            Model.ExpectedCredentialRevision,
            Model.SecretAlias.Trim());
        _confirmationToken = Confirmations.Issue(subject, _draft);
        if (_confirmationToken is null)
        {
            _draft = null;
            Result = "confirmation-unavailable";
        }
    }

    private ResultMessage? GetResultMessage() => Result switch
    {
        "updated" => new ResultMessage(
            "Credential binding updated",
            "The metadata below was read after the API accepted the binding. Monitoring remains paused."),
        "invalid" => new ResultMessage(
            "Binding was not accepted",
            "Confirm the reviewed alias before submitting it."),
        "confirmation-expired" => new ResultMessage(
            "Confirmation expired",
            "No credential change was submitted. Enter the alias and create a new review."),
        "confirmation-unavailable" => new ResultMessage(
            "Confirmation is temporarily unavailable",
            "No credential change was submitted. Try again after existing confirmations expire."),
        "monitoring-enabled" => new ResultMessage(
            "Monitoring is active",
            "The binding was not changed. Pause monitoring and review current metadata first."),
        "commands-in-progress" => new ResultMessage(
            "A command is still in progress",
            "The binding was not changed. Wait for pending and running commands to reach a terminal state."),
        "conflict" => new ResultMessage(
            "Credential metadata changed",
            "The binding was not changed because the server or credential revision is stale. Review current metadata."),
        "rejected" => new ResultMessage(
            "Credential binding was rejected",
            "The API rejected the reviewed alias or revisions. Prepare a new review from current metadata."),
        "update-unknown" => new ResultMessage(
            "Binding outcome is uncertain",
            "The Web host did not retry the request. Current metadata was loaded for reconciliation."),
        "server-not-found" => new ResultMessage(
            "Server is no longer available",
            "No credential change was applied. Return to the server inventory."),
        _ => null
    };

    private string GetResultClass() => Result switch
    {
        "updated" => "result-state--success",
        "confirmation-expired" or "confirmation-unavailable" or "monitoring-enabled" or
            "commands-in-progress" or "conflict" or "update-unknown" => "result-state--warning",
        _ => "result-state--error"
    };

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("dd MMM yyyy, HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) ?? "Not available";

    private sealed class CredentialFormModel
    {
        [Range(1, long.MaxValue, ErrorMessage = "Server revision must be positive.")]
        public long ExpectedServerRevision { get; set; }

        [Range(0, long.MaxValue, ErrorMessage = "Credential revision must not be negative.")]
        public long ExpectedCredentialRevision { get; set; }

        [Required(ErrorMessage = "Secret alias is required.")]
        [StringLength(
            SetRconCredentialRequest.MaxSecretAliasLength,
            ErrorMessage = "Secret alias must not exceed 128 characters.")]
        [RegularExpression(
            @"^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
            ErrorMessage = "Use letters, digits, dots, underscores, or hyphens, starting and ending with a letter or digit.")]
        public string SecretAlias { get; set; } = string.Empty;

        public static CredentialFormModel From(
            ServerResponse server,
            ServerCredentialResponse? credential) =>
            new()
            {
                ExpectedServerRevision = server.Revision,
                ExpectedCredentialRevision = credential?.Revision ?? 0
            };
    }

    private sealed record ResultMessage(string Title, string Detail);
}
