@page "/operator/provider-delivery/dead-letters"
@attribute [Authorize(Policy = WebSecurity.OperatorPolicy)]
@inject IProviderOperationsClient ProviderOperationsClient
@inject ILogger<ProviderDeadLetters> Logger

<PageTitle>Provider dead letters | GoldSrcOps</PageTitle>

<div class="provider-dead-letters-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">Provider operations</p>
            <h1>Provider dead letters</h1>
        </div>
        <p>Terminal provider messages and their immutable review records.</p>
    </header>

    @if (!ProviderOperationsClient.IsEnabled)
    {
        <section class="load-state" role="status">
            <h2>Provider operations are disabled</h2>
            <p>The Web host has no active receiver operations boundary. No request was sent.</p>
        </section>
    }
    else if (_loadFailed)
    {
        <section class="load-state" role="alert">
            <h2>Provider dead-letter data is unavailable</h2>
            <p>The receiver did not return a usable operations page. No review was attempted.</p>
        </section>
    }
    else if (_page is not null)
    {
        <section class="summary" aria-label="Provider dead-letter summary">
            <article class="summary--alert">
                <span>On this page</span>
                <strong>@_page.Items.Count</strong>
            </article>
            <article>
                <span>Awaiting review</span>
                <strong>@_page.Items.Count(static item => item.Review is null)</strong>
            </article>
            <article class="summary--reviewed">
                <span>Reviewed</span>
                <strong>@_page.Items.Count(static item => item.Review is not null)</strong>
            </article>
        </section>

        <section class="list-section" aria-labelledby="provider-dead-letter-list-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Receiver outbox</p>
                    <h2 id="provider-dead-letter-list-title">Terminal messages</h2>
                </div>
                <span>Up to @_page.Limit messages</span>
            </div>

            @if (_page.Items.Count == 0)
            {
                <div class="empty-state">
                    <h3>No provider dead letters</h3>
                    <p>No terminal provider message currently requires review.</p>
                </div>
            }
            else
            {
                <div class="message-table" role="table" aria-label="Provider dead-letter messages">
                    <div class="message-row message-row--header" role="row">
                        <span role="columnheader">Action</span>
                        <span role="columnheader">Dead-lettered</span>
                        <span role="columnheader">Attempts</span>
                        <span role="columnheader">Review</span>
                        <span role="columnheader">Failure</span>
                        <span role="columnheader"><span class="visually-hidden">Open</span></span>
                    </div>
                    @foreach (var item in _page.Items)
                    {
                        <div class="message-row" role="row">
                            <span class="action" role="cell">
                                <span class="cell-label">Action</span>
                                @item.Action
                            </span>
                            <time role="cell" datetime="@item.DeadLetteredAtUtc.ToString("O", CultureInfo.InvariantCulture)">
                                <span class="cell-label">Dead-lettered</span>
                                @FormatDateTime(item.DeadLetteredAtUtc)
                            </time>
                            <span role="cell"><span class="cell-label">Attempts</span>@item.AttemptCount</span>
                            <span class="@(item.Review is null ? "review-pending" : "review-complete")" role="cell">
                                <span class="cell-label">Review</span>
                                @(item.Review is null ? "Pending" : "Recorded")
                            </span>
                            <span class="failure" role="cell">
                                <span class="cell-label">Failure</span>
                                @DisplayValue(item.FailureSummary)
                            </span>
                            <span class="row-action" role="cell">
                                <a href="@($"/operator/provider-delivery/dead-letters/{item.MessageId:D}")"
                                   aria-label="Inspect @item.Action provider dead letter">Inspect</a>
                            </span>
                        </div>
                    }
                </div>

                @if (NextPageHref is not null)
                {
                    <nav class="pagination" aria-label="Provider dead-letter pagination">
                        <a href="@NextPageHref">Next page</a>
                    </nav>
                }
            }
        </section>
    }
</div>

@code {
    private const int PageLimit = 50;

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? Cursor { get; set; }

    private ProviderDeadLetterListResponse? _page;
    private bool _loadFailed;

    private string? NextPageHref => string.IsNullOrWhiteSpace(_page?.NextCursor)
        ? null
        : $"/operator/provider-delivery/dead-letters?cursor={Uri.EscapeDataString(_page.NextCursor)}";

    protected override async Task OnParametersSetAsync()
    {
        _page = null;
        _loadFailed = false;
        if (!ProviderOperationsClient.IsEnabled)
        {
            return;
        }

        try
        {
            _page = await ProviderOperationsClient.GetDeadLettersAsync(
                string.IsNullOrWhiteSpace(Cursor) ? null : Cursor,
                PageLimit);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException)
        {
            Logger.LogWarning(exception, "Unable to load the provider dead-letter page.");
            _loadFailed = true;
        }
    }

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not available" : value;

    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("dd MMM yyyy, HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
}
