@page "/operator/credential-expiry"
@attribute [Authorize(Policy = WebSecurity.OperatorPolicy)]
@inject ICredentialExpiryClient ExpiryClient
@inject TimeProvider TimeProvider

<PageTitle>Credential expiry | GoldSrcOps</PageTitle>

<div class="expiry-page">
    <header>
        <p class="eyebrow">Operator portal</p>
        <h1>Credential expiry</h1>
        <p>Recorded expiry metadata for four operational access purposes.</p>
        <a href="@CredentialExpiryView.Path" data-enhance-nav="false">Refresh</a>
        <a href="@HealthPath">Game-host health</a>
    </header>
    <p>Evaluated: @FormatTime(_snapshot?.EvaluatedAtUtc). This page does not refresh automatically.</p>
    <p>These are recorded dates, not live provider checks or proof that a credential works. A rotation requires a separately reviewed operation and a metadata update.</p>
    <p>Warnings use the recorded deadline: within 30 days, within 7 days, or deadline passed. Days remaining are rounded up and shown as 0 after the deadline.</p>
    <div class="expiry-grid">
        @foreach (var label in CredentialExpiryView.Catalog)
        {
            var entry = _entries.Single(item => item.Key == label.Key);
            <section class="expiry-card" aria-label="@label.Purpose">
                <h2>@label.Purpose</h2>
                <strong class="expiry-state" data-state="@entry.State">@CredentialExpiryView.StateLabel(entry.State, entry.ExpiresAtMinuteUtc is not null)</strong>
                <dl>
                    <dt>Provider</dt><dd>@label.Provider</dd>
                    <dt>Consumer</dt><dd>@label.Consumer</dd>
                    <dt>Recorded expiry</dt><dd>@(entry.ExpiresAtMinuteUtc is { } minute ? minute.Replace('T', ' ')[..^1] + " UTC" : FormatTime(entry.ExpiresAtUtc))</dd>
                    <dt>Last verified</dt><dd>@FormatTime(entry.VerifiedAtUtc)</dd>
                    <dt>Days remaining</dt><dd>@(entry.RemainingDays?.ToString(CultureInfo.InvariantCulture) ?? "Unknown")</dd>
                </dl>
                @if (entry.ExpiresAtMinuteUtc is not null)
                {
                    <p>Precision: minute; warnings use the start of this minute and can appear up to one minute early. Reaching it does not establish that access has failed.</p>
                }
                @if (entry.State == "Unknown")
                {
                    <p>Expiry metadata is missing, unverified or unavailable. Unknown does not establish that access is valid or has no expiry.</p>
                }
            </section>
        }
    </div>
    <p>Refresh to obtain a new evaluation. Verify dates in the owning provider and record them through the existing deployment configuration. Secret values are not part of this register. This page does not send email or change credentials.</p>
</div>

@code {
    private const string HealthPath = "/operator/game-host-health";
    private CredentialExpiryResponse? _snapshot;
    private IReadOnlyList<CredentialExpiryEntryResponse> _entries = CredentialExpiryView.Create(null, DateTimeOffset.UnixEpoch);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await ExpiryClient.ReadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or System.Text.Json.JsonException)
        {
            _snapshot = null;
        }

        _entries = CredentialExpiryView.Create(_snapshot, TimeProvider.GetUtcNow());
    }

    private static string FormatTime(DateTimeOffset? value) => value?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture) ?? "Unknown";
}
