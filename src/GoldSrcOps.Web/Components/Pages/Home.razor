@page "/"
@inject PublicStatusClient StatusClient
@inject ILogger<Home> Logger

<PageTitle>@Text["StatusTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Text["StatusDescription"]" />
</HeadContent>

<div class="status-page" lang="@Text.Code">
    <PublicLanguageSwitch Path="@HistoryPath" Language="@Text.Code" />
    <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">@Text["FleetEyebrow"]</p>
        <h1 id="page-title">GoldSrcOps</h1>
        <p class="lede">@Text["StatusLede"]</p>
    </section>

    @if (_isLoading)
    {
        <section class="status-loading" aria-busy="true" aria-live="polite">
            <div class="loading-signal" aria-hidden="true"></div>
            <div>
                <p class="loading-title">@Text["LoadingStatus"]</p>
                <p class="loading-copy">@Text["LoadingStatusDetail"]</p>
            </div>
        </section>
    }
    else
    {
        @if (_status is null)
        {
            <section class="status-summary status-summary--unavailable" role="status">
                <div class="summary-copy">
                    <span class="status-signal" aria-hidden="true"></span>
                    <div>
                        <p class="status-kicker">@Text["StatusUnavailable"]</p>
                        <h2>@Text["StatusUnavailableHeading"]</h2>
                        <p>@Text["StatusUnavailableDetail"]</p>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="status-summary @SummaryClass" role="status">
                <div class="summary-copy">
                    <span class="status-signal" aria-hidden="true"></span>
                    <div>
                        <p class="status-kicker">@StatusLabel</p>
                        <h2>@StatusHeading</h2>
                        <p>@StatusDescription</p>
                    </div>
                </div>

                <div class="observation-time">
                    <span>@Text["LastObservation"]</span>
                    @if (_status.LastObservedAtUtc is { } observedAtUtc)
                    {
                        <time datetime="@observedAtUtc.ToString("O")">
                            @observedAtUtc.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'", CultureInfo.InvariantCulture)
                        </time>
                    }
                    else
                    {
                        <strong>@Text["NotAvailable"]</strong>
                    }
                </div>
            </section>

            <section class="fleet" aria-labelledby="fleet-title">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">@Text["CurrentSnapshot"]</p>
                        <h2 id="fleet-title">@Text["MonitoredFleet"]</h2>
                    </div>
                    <p>@FleetSummary</p>
                </div>

                <div class="fleet-meter" role="img" aria-label="@FleetSummary">
                    @if (_status.MonitoredServers > 0)
                    {
                        <span class="fleet-meter__online" style="flex-grow: @_status.OnlineServers"></span>
                        <span class="fleet-meter__attention" style="flex-grow: @_status.ServersRequiringAttention"></span>
                    }
                    else
                    {
                        <span class="fleet-meter__empty"></span>
                    }
                </div>

                <div class="metrics">
                    <article class="metric">
                        <span class="metric-label">@Text["Monitored"]</span>
                        <strong>@_status.MonitoredServers</strong>
                        <span>@Text["EnabledServers"]</span>
                    </article>
                    <article class="metric metric--online">
                        <span class="metric-label">@Text["StatusOnline"]</span>
                        <strong>@_status.OnlineServers</strong>
                        <span>@Text["RespondingNormally"]</span>
                    </article>
                    <article class="metric metric--attention">
                        <span class="metric-label">@Text["Attention"]</span>
                        <strong>@_status.ServersRequiringAttention</strong>
                        <span>@Text["OfflineOrUnknown"]</span>
                    </article>
                    <article class="metric metric--incidents">
                        <span class="metric-label">@Text["OpenIncidents"]</span>
                        <strong>@_status.OpenIncidents</strong>
                        <span>@Text["ActiveAvailabilityEvents"]</span>
                    </article>
                </div>
            </section>
        }

        @if (_publicServer is not null)
        {
            <section class="public-server public-server--@NormalizeServerState(_publicServer.State)"
                     aria-labelledby="public-server-title">
                <div class="public-server__heading">
                    <div>
                        <p class="eyebrow">@Text["PublicServer"]</p>
                        <h2 id="public-server-title">@_publicServer.Name</h2>
                    </div>
                    <p class="public-server__state">
                        <span class="public-server__signal" aria-hidden="true"></span>
                        @PublicServerStateLabel
                    </p>
                </div>

                <div class="public-server__body">
                    <dl class="public-server__facts">
                        <div>
                            <dt>@Text["Map"]</dt>
                            <dd>@(_publicServer.Map ?? Text["NotAvailable"])</dd>
                        </div>
                        <div>
                            <dt>@Text["Players"]</dt>
                            <dd>@PlayerSummary</dd>
                        </div>
                        <div>
                            <dt>@Text["Observed"]</dt>
                            <dd>
                                @if (_publicServer.LastObservedAtUtc is { } serverObservedAtUtc)
                                {
                                    <time datetime="@serverObservedAtUtc.ToString("O")">
                                        @serverObservedAtUtc.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'", CultureInfo.InvariantCulture)
                                    </time>
                                }
                                else
                                {
                                    <span>@Text["NotAvailable"]</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <div class="public-server__connect">
                        <span class="public-server__connect-label">@Text["ConnectionCommand"]</span>
                        <code>@ConnectCommand</code>
                        <div class="public-server__actions">
                            <a class="public-server__steam" href="@SteamConnectUri">@Text["ConnectWithSteam"]</a>
                            <button class="public-server__copy"
                                    type="button"
                                    data-copy-connect="@ConnectCommand"
                                    data-copy-success="@Text["CopySuccess"]"
                                    data-copy-failure="@Text["CopyFailure"]"
                                    aria-describedby="public-server-copy-status">@Text["CopyCommand"]</button>
                        </div>
                        <p id="public-server-copy-status" class="public-server__copy-status" aria-live="polite"></p>
                        <a href="@Text.Link("/play")">@Text["PlayGuideLink"]</a>
                    </div>
                </div>
            </section>
        }

        <section class="history" aria-labelledby="history-title">
            <div class="history-heading">
                <div>
                    <p class="eyebrow">@Text["RecordedProbes"]</p>
                    <h2 id="history-title">@Text["HistoryTitle"]</h2>
                </div>
                <nav class="range-switch" aria-label="@Text["HistoryWindow"]">
                    <a class="@GetRangeClass(PublicStatusClient.Last24HoursWindow)"
                       href="@Text.Link("/?range=24h")"
                       aria-current="@GetRangeAriaCurrent(PublicStatusClient.Last24HoursWindow)">@Text["Hours24"]</a>
                    <a class="@GetRangeClass(PublicStatusClient.Last7DaysWindow)"
                       href="@Text.Link("/?range=7d")"
                       aria-current="@GetRangeAriaCurrent(PublicStatusClient.Last7DaysWindow)">@Text["Days7"]</a>
                </nav>
            </div>

            @if (_history is null)
            {
                <div class="history-unavailable" role="status">
                    <strong>@Text["HistoryUnavailable"]</strong>
                    <span>@Text["HistoryUnavailableDetail"]</span>
                </div>
            }
            else
            {
                <div class="history-summary">
                    <div>
                        <span>@Text["ObservedReachability"]</span>
                        <strong>@HistoryPercentage</strong>
                    </div>
                    <div>
                        <span>@Text["ObservationCoverage"]</span>
                        <strong>@Text.Format("Coverage", _history.ObservedBuckets, _history.TotalBuckets)</strong>
                    </div>
                </div>

                <div class="history-chart"
                     style="--history-columns: @_history.TotalBuckets"
                     role="list"
                     aria-label="@HistoryChartLabel">
                    @foreach (var bucket in _history.Buckets)
                    {
                        <span class="history-bar history-bar--@NormalizeBucketState(bucket.State)"
                              style="@GetBucketStyle(bucket)"
                              role="listitem"
                              title="@GetBucketLabel(bucket)"
                              aria-label="@GetBucketLabel(bucket)"></span>
                    }
                </div>

                <div class="history-axis" aria-hidden="true">
                    <time datetime="@_history.FromUtc.ToString("O")">@FormatAxisTime(_history.FromUtc)</time>
                    <span>@HistoryWindowLabel</span>
                    <time datetime="@_history.ToUtc.ToString("O")">@FormatAxisTime(_history.ToUtc)</time>
                </div>

                <div class="history-legend" aria-label="@Text["ChartLegend"]">
                    <span><i class="legend-signal legend-signal--operational" aria-hidden="true"></i>@Text["AllProbesReached"]</span>
                    <span><i class="legend-signal legend-signal--degraded" aria-hidden="true"></i>@Text["MixedResults"]</span>
                    <span><i class="legend-signal legend-signal--unreachable" aria-hidden="true"></i>@Text["NoProbeReached"]</span>
                    <span><i class="legend-signal legend-signal--unknown" aria-hidden="true"></i>@Text["NoObservations"]</span>
                </div>
            }
        </section>

        <section class="scope-note" aria-labelledby="scope-title">
            <h2 id="scope-title">@Text["ReportScopeTitle"]</h2>
            <p>
                @Text["ReportScope"]
            </p>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "lang")]
    private string? Language { get; set; }

    private PublicPageText Text => PublicPageText.For(Language);

    private string HistoryPath => $"/?range={SelectedWindow}";

    [Parameter]
    [SupplyParameterFromQuery(Name = "range")]
    public string? Range { get; set; }

    private PublicStatusResponse? _status;
    private PublicA2sHistoryResponse? _history;
    private PublicServerJoinResponse? _publicServer;
    private bool _isLoading = true;

    private string SelectedWindow => string.Equals(
        Range,
        PublicStatusClient.Last7DaysWindow,
        StringComparison.Ordinal)
        ? PublicStatusClient.Last7DaysWindow
        : PublicStatusClient.Last24HoursWindow;

    private string SummaryClass => _status?.State switch
    {
        "operational" => "status-summary--operational",
        "degraded" => "status-summary--degraded",
        _ => "status-summary--unknown"
    };

    private string StatusLabel => _status?.State switch
    {
        "operational" => Text["Operational"],
        "degraded" => Text["Degraded"],
        _ => Text["StatusUnknown"]
    };

    private string StatusHeading => _status?.State switch
    {
        "operational" => Text["OperationalHeading"],
        "degraded" => Text["DegradedHeading"],
        _ => Text["UnknownHeading"]
    };

    private string StatusDescription => _status?.State switch
    {
        "operational" => Text["OperationalDetail"],
        "degraded" => Text["DegradedDetail"],
        _ => Text["StatusUnknownDetail"]
    };

    private string FleetSummary => _status is null
        ? Text["NoFleetData"]
        : Text.Format("FleetSummary", _status.OnlineServers, _status.MonitoredServers);

    private string HistoryPercentage => _history?.ObservedReachabilityPercent is { } percentage
        ? $"{percentage.ToString("0.0", CultureInfo.InvariantCulture)}%"
        : Text["NoObservations"];

    private string HistoryWindowLabel => string.Equals(
        SelectedWindow,
        PublicStatusClient.Last7DaysWindow,
        StringComparison.Ordinal)
        ? Text["SixHourBuckets"]
        : Text["HourlyBuckets"];

    private string HistoryChartLabel => _history is null
        ? Text["HistoryChartUnavailable"]
        : Text.Format("HistoryChart", FormatAxisTime(_history.FromUtc), FormatAxisTime(_history.ToUtc), _history.ObservedBuckets, _history.TotalBuckets);

    private string PublicServerStateLabel => _publicServer?.State switch
    {
        "online" => Text["StatusOnline"],
        "offline" => Text["StatusOffline"],
        _ => Text["StatusUnknown"]
    };

    private string PlayerSummary => _publicServer is { Players: { } players, MaxPlayers: { } maxPlayers }
        ? $"{players} / {maxPlayers}"
        : Text["NotAvailable"];

    private string ConnectAddress => _publicServer is null
        ? string.Empty
        : $"{_publicServer.Host}:{_publicServer.Port.ToString(CultureInfo.InvariantCulture)}";

    private string ConnectCommand => $"connect {ConnectAddress}";

    private string SteamConnectUri => $"steam://connect/{ConnectAddress}";

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _status = null;
        _history = null;
        _publicServer = null;

        await Task.WhenAll(
            LoadStatusAsync(),
            LoadHistoryAsync(SelectedWindow),
            LoadPublicServerAsync());
        _isLoading = false;
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            _status = await StatusClient.GetStatusAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException)
        {
            Logger.LogWarning(exception, "Unable to load the public fleet status.");
        }
    }

    private async Task LoadHistoryAsync(string window)
    {
        try
        {
            _history = await StatusClient.GetA2sHistoryAsync(window);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException)
        {
            Logger.LogWarning(exception, "Unable to load the public A2S history for window {Window}.", window);
        }
    }

    private async Task LoadPublicServerAsync()
    {
        try
        {
            _publicServer = await StatusClient.GetServerJoinAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException)
        {
            Logger.LogWarning(exception, "Unable to load the public server join projection.");
        }
    }

    private string GetRangeClass(string window) => string.Equals(SelectedWindow, window, StringComparison.Ordinal)
        ? "range-switch__link range-switch__link--active"
        : "range-switch__link";

    private string? GetRangeAriaCurrent(string window) =>
        string.Equals(SelectedWindow, window, StringComparison.Ordinal) ? "page" : null;

    private static string NormalizeBucketState(string state) => state switch
    {
        "operational" => "operational",
        "degraded" => "degraded",
        "unreachable" => "unreachable",
        _ => "unknown"
    };

    private static string NormalizeServerState(string state) => state switch
    {
        "online" => "online",
        "offline" => "offline",
        _ => "unknown"
    };

    private static string GetBucketStyle(PublicA2sBucketResponse bucket)
    {
        var height = Math.Clamp(bucket.ObservedReachabilityPercent ?? 8m, 0m, 100m);
        return $"height: {height.ToString("0.#", CultureInfo.InvariantCulture)}%;";
    }

    private string GetBucketLabel(PublicA2sBucketResponse bucket)
    {
        var startedAt = bucket.StartedAtUtc.ToUniversalTime()
            .ToString("dd MMM yyyy, HH:mm 'UTC'", CultureInfo.InvariantCulture);
        var result = bucket.ObservedReachabilityPercent is { } percentage
            ? Text.Format("BucketPercent", percentage.ToString("0.0", CultureInfo.InvariantCulture))
            : Text["NoObservations"];
        return Text.Format("BucketLabel", startedAt, result);
    }

    private static string FormatAxisTime(DateTimeOffset value) => value.ToUniversalTime()
        .ToString("dd MMM, HH:mm 'UTC'", CultureInfo.InvariantCulture);
}
