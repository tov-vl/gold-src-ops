@page "/play"
@inject PublicStatusClient StatusClient
@inject ILogger<Play> Logger

<PageTitle>@Text["PlayTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Text["PlayDescription"]" />
</HeadContent>

<div class="play-page" lang="@Text.Code"
     data-age="@Text["Age"]"
     data-refresh-paused="@Text["RefreshPaused"]"
     data-refresh-active="@Text["RefreshActive"]"
     data-unknown="@Text["Unknown"]"
     data-unknown-detail="@Text["UnknownDetail"]"
     data-no-fresh-data="@Text["NoFreshData"]"
     data-try-join="@Text["TryJoin"]"
     data-expired-check="@Text["ExpiredCheck"]"
     data-refreshing-status="@Text["RefreshingStatus"]"
     data-status-done="@Text["StatusDone"]"
     data-status-failure-warning="@Text["StatusFailureWarning"]"
     data-status-failure="@Text["StatusFailure"]">
    <PublicLanguageSwitch Path="/play" Language="@Text.Code" />
    <section class="play-hero" aria-labelledby="play-title">
        <div class="play-intro">
            <p class="eyebrow">Counter-Strike 1.6 / @Text["PilotServer"]</p>
            <h1 id="play-title">@Text["MorePlay"]<br />@Text["LessWaiting"]</h1>
            <p class="play-lede">@Text["PlayLede"]</p>
            <p class="play-intro__hint">@Text["IntroBefore"] <code>/menu</code> @Text["IntroAfter"]</p>
            <a class="play-intro__link" href="@(Text.Link("/play") + "#first-steps")">@Text["HowToStart"] <span aria-hidden="true">↓</span></a>
        </div>

        <section id="connection" tabindex="-1" class="join-panel join-panel--@ServerState" aria-labelledby="join-title">
            <p class="eyebrow">@Text["JoinServer"]</p>
            <h2 id="join-title">@(_server?.Name ?? "GoldSrcOps")</h2>
            <a id="check-connection" class="join-panel__refresh" href="@Text.Link("/play")" data-play-refresh>@Text["RefreshStatus"]</a>
            <p id="play-refresh-status" class="join-panel__refresh-status">@Text["RefreshStatusHint"]</p>
            <p class="visually-hidden" role="status" aria-atomic="true" data-refresh-announcement></p>
            <div data-play-status data-state="@ServerState" data-age-seconds="@AgeAttribute">
                @if (_isLoading)
                {
                    <p class="join-panel__notice" aria-busy="true">@Text["CheckingServer"]</p>
                }
                else if (_server is null)
                {
                    <p class="join-panel__notice">@Text["JoinUnavailable"]</p>
                    <p class="join-panel__detail">@Text["JoinUnavailableDetail"]</p>
                    <a class="join-panel__status-link" href="@Text.Link("/")">@Text["GeneralStatus"]</a>
                }
                else
                {
                    <p class="join-panel__state">
                        <span class="join-panel__signal" aria-hidden="true"></span>@ServerStateLabel
                    </p>
                    <p class="join-panel__detail">@ServerStateDescription</p>
                    <dl class="join-panel__facts">
                        <div><dt>@Text["Map"]</dt><dd>@MapLabel</dd></div>
                        <div><dt>@Text["Players"]</dt><dd>@PlayerLabel</dd></div>
                    </dl>
                    <p class="join-panel__observed">
                        @Text["LastCheck"]
                        @if (_server.LastObservedAtUtc is { } observedAt)
                        {
                            <time datetime="@observedAt.ToString("O")">@observedAt.ToUniversalTime().ToString("dd.MM.yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)</time>
                        }
                        else
                        {
                            <span>@Text["NoObservation"]</span>
                        }
                        @if (ObservationAgeSeconds is { } age)
                        {
                            <span class="join-panel__age" data-play-age>@Text.Age(age)</span>
                        }
                    </p>
                    <p class="join-panel__warning" data-play-warning hidden="@(ServerState is "online" or "offline")">@Text["UnconfirmedWarning"]</p>
                }
            </div>
            @if (_server is not null)
            {
                <div data-play-connection>
                    <a class="join-panel__steam" href="@SteamConnectUri">@(IsOnline ? Text["JoinSteam"] : Text["TryJoin"])</a>
                    <p class="join-panel__command-label">@Text["ConsoleHint"]</p>
                    <code class="join-panel__command">@ConnectCommand</code>
                    <button class="join-panel__copy" type="button"
                            data-copy-connect="@ConnectCommand"
                            data-copy-success="@Text["CopySuccess"]"
                            data-copy-failure="@Text["CopyFailure"]"
                            aria-describedby="play-copy-status">@Text["CopyCommand"]</button>
                    <p id="play-copy-status" class="join-panel__copy-status" aria-live="polite"></p>
                </div>
            }
            <p class="join-panel__help"><a href="@(Text.Link("/play") + "#connection-help")">@Text["ConnectionHelpTitle"]</a></p>
        </section>
    </section>

    <section id="connection-help" tabindex="-1" class="play-section connection-help" aria-labelledby="connection-help-title">
        <div class="play-section__heading">
            <h2 id="connection-help-title">@Text["ConnectionHelpTitle"]</h2>
            <p>@Text["ConnectionHelpIntro"]</p>
        </div>
        <details>
            <summary>@Text["SteamHelpTitle"]</summary>
            <p>@Text["SteamHelpDetail"]</p>
            <a href="@(Text.Link("/play") + "#connection")">@Text["BackToConnection"]</a>
        </details>
        <details>
            <summary>@Text["CopyHelpTitle"]</summary>
            <p>@Text["CopyHelpDetail"]</p>
            <a href="@(Text.Link("/play") + "#connection")">@Text["BackToConnection"]</a>
        </details>
        <details>
            <summary>@Text["StatusHelpTitle"]</summary>
            <p>@Text["OfflineHelpDetail"]</p>
            <p>@Text["UnknownHelpDetail"]</p>
            <p>@Text["MissingHelpDetail"]</p>
            <a href="@(Text.Link("/play") + "#check-connection")">@Text["BackToCheck"]</a>
        </details>
        <details>
            <summary>@Text["JoinedHelpTitle"]</summary>
            <p>@Text["JoinedHelpBefore"] <code>/menu</code>@Text["JoinedHelpAfter"]</p>
            <a href="@(Text.Link("/play") + "#first-steps")">@Text["HowToStart"]</a>
        </details>
    </section>

    <section id="first-steps" tabindex="-1" class="play-section" aria-labelledby="first-steps-title">
        <div class="play-section__heading">
            <p class="eyebrow">@Text["FirstConnection"]</p>
            <h2 id="first-steps-title">@Text["ThreeSteps"]</h2>
        </div>
        <ol class="first-steps">
            <li><span class="step-number" aria-hidden="true">01</span><div><h3>@Text["ChooseTeam"]</h3><p>@Text["ChooseTeamDetail"]</p></div></li>
            <li><span class="step-number" aria-hidden="true">02</span><div><h3>@Text["ChooseWeapons"]</h3><p>@Text["Write"] <code>/guns</code> @Text["WeaponsAfter"]</p></div></li>
            <li><span class="step-number" aria-hidden="true">03</span><div><h3>@Text["FollowProgress"]</h3><p>@Text["Open"] <code>/profile</code>@Text["ProfileAfter"]</p></div></li>
        </ol>
    </section>

    <section class="play-section progress-guide" aria-labelledby="progress-title">
        <div class="play-section__heading">
            <p class="eyebrow">@Text["ProgressBetween"]</p>
            <h2 id="progress-title">@Text["NextRank"]</h2>
        </div>
        <div class="progress-guide__body">
            <div>
                <p>@Text["RankGuide"]</p>
                <p>@Text["RankFairness"]</p>
            </div>
            <div class="progress-guide__saved">
                <h3>@Text["ReturnProgress"]</h3>
                <p>@Text["SavedIdentity"]</p>
                <p>@Text["SettingsBefore"] <code>/settings</code> @Text["SettingsAfter"]</p>
            </div>
        </div>
    </section>

    <section class="play-section" aria-labelledby="commands-title">
        <div class="play-section__heading">
            <p class="eyebrow">@Text["Handy"]</p>
            <h2 id="commands-title">@Text["ChatCommands"]</h2>
            <p>@Text["CommandsHint"]</p>
        </div>
        <dl class="command-guide">
            <div><dt><code>/menu</code></dt><dd>@Text["MenuCommand"]</dd></div>
            <div><dt><code>/guns</code></dt><dd>@Text["GunsCommand"]</dd></div>
            <div><dt><code>/profile</code></dt><dd>@Text["ProfileCommand"]</dd></div>
            <div><dt><code>/settings</code></dt><dd>@Text["SettingsCommand"]</dd></div>
            <div><dt><code>/maps</code></dt><dd>@Text["MapsCommand"]</dd></div>
            <div><dt><code>/help</code></dt><dd>@Text["HelpCommand"]</dd></div>
        </dl>
    </section>

    <p><a href="@Text.Link("/leaderboard")">@Text["ViewTop"]</a></p>
    <p class="play-footer-note">@Text["StartWith"] <code>/menu</code>@Text["PlayFootnote"]</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "lang")]
    private string? Language { get; set; }

    private PublicPageText Text => PublicPageText.For(Language);

    private PublicServerJoinResponse? _server;
    private bool _isLoading = true;

    private double? ObservationAgeSeconds => _server?.LastObservedAtUtc is { } observed
        ? Math.Max(0, (DateTimeOffset.UtcNow - observed).TotalSeconds) : null;

    private string AgeAttribute => ObservationAgeSeconds?.ToString("F3", CultureInfo.InvariantCulture) ?? string.Empty;

    private string ServerState => _server is null ? "unavailable" : ObservationAgeSeconds is null or > 180 ? "unknown" : _server.State switch
    {
        "online" => "online",
        "offline" => "offline",
        _ => "unknown"
    };

    private bool IsOnline => string.Equals(ServerState, "online", StringComparison.Ordinal);

    private string ServerStateLabel => ServerState switch
    {
        "online" => Text["Online"],
        "offline" => Text["Offline"],
        _ => Text["Unknown"]
    };

    private string ServerStateDescription => ServerState switch
    {
        "online" => Text["OnlineDetail"],
        "offline" => Text["OfflineDetail"],
        _ => Text["UnknownDetail"]
    };

    private string MapLabel => IsOnline ? _server?.Map ?? Text["NoDataYet"] : Text["NoFreshData"];

    private string PlayerLabel => IsOnline && _server is { Players: { } players, MaxPlayers: { } capacity }
        ? $"{players} / {capacity}"
        : Text["NoFreshData"];

    private string ConnectAddress => _server is null
        ? string.Empty
        : $"{_server.Host}:{_server.Port.ToString(CultureInfo.InvariantCulture)}";

    private string ConnectCommand => $"connect {ConnectAddress}";

    private string SteamConnectUri => $"steam://connect/{ConnectAddress}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _server = await StatusClient.GetServerJoinAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or System.Text.Json.JsonException)
        {
            Logger.LogWarning("Unable to load the public player guide server projection.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
