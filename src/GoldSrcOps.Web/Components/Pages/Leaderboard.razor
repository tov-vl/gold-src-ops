@page "/leaderboard"
@inject PublicStatusClient StatusClient
@inject ILogger<Leaderboard> Logger

<PageTitle>@Text["LeaderboardTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Text["LeaderboardDescription"]" />
</HeadContent>

<div class="leaderboard-page" lang="@Text.Code"
     data-age="@Text["Age"]"
     data-refresh-paused="@Text["RefreshPaused"]"
     data-refresh-active="@Text["RefreshActive"]"
     data-stale="@Text["Stale"]"
     data-unavailable="@Text["Unavailable"]"
     data-expired-leaderboard="@Text["ExpiredLeaderboard"]"
     data-refreshing-leaderboard="@Text["RefreshingLeaderboard"]"
     data-leaderboard-done="@Text["LeaderboardDone"]"
     data-leaderboard-done-stale="@Text["LeaderboardDoneStale"]"
     data-leaderboard-failure="@Text["LeaderboardFailure"]">
    <PublicLanguageSwitch Path="/leaderboard" Language="@Text.Code" />
    <header class="leaderboard-header">
        <p class="eyebrow">Counter-Strike 1.6 / @Text["PlayerRanking"]</p>
        <h1>@Text["TopTen"]</h1>
        <p>@Text["LeaderboardBefore"] <code>/topall</code> @Text["LeaderboardAfter"]</p>
        <a class="leaderboard-join" href="@Text.Link("/play")">@Text["PlayOnServer"] <span aria-hidden="true">→</span></a>
    </header>

    <div class="leaderboard-refresh">
        <a class="leaderboard-refresh__button" href="@Text.Link("/leaderboard")" data-leaderboard-refresh>@Text["Refresh"]</a>
        <p id="leaderboard-refresh-status">@Text["RefreshHint"]</p>
        <p class="visually-hidden" role="status" aria-atomic="true" data-refresh-announcement></p>
    </div>
    <section class="leaderboard-panel" aria-labelledby="leaderboard-title" data-leaderboard-panel
             data-state="@State" data-age-seconds="@SnapshotAgeSeconds.ToString(CultureInfo.InvariantCulture)">
        <div class="leaderboard-panel__heading">
            <h2 id="leaderboard-title">@Text["SavedResults"]</h2>
            <p class="leaderboard-state leaderboard-state--@State">@StateLabel</p>
        </div>
        @if (_snapshot is { CapturedAtUtc: { } captured } && State is "fresh" or "stale")
        {
            <p class="leaderboard-updated">@Text["SnapshotTime"]
                <time datetime="@captured.ToString("O")">@captured.ToUniversalTime().ToString("dd.MM.yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)</time>
                <span class="leaderboard-age" data-leaderboard-age>@Text.Age(SnapshotAgeSeconds)</span>
            </p>
        }
        <p class="leaderboard-notice" data-leaderboard-notice hidden="@(State != "stale")">@Text["StaleNotice"]</p>
        @if (_snapshot is { Entries.Count: > 0 } && State is "fresh" or "stale")
        {
            <p class="leaderboard-progress-hint">@Text["RankProgressHint"]</p>
            <table class="leaderboard-table">
                <caption class="visually-hidden">@Text["TableCaption"]</caption>
                <colgroup><col class="place-column" /><col class="name-column" /><col class="rank-column" /><col class="score-column" /><col class="score-column" /></colgroup>
                <thead><tr><th scope="col"><span class="wide-label">@Text["Place"]</span><abbr class="compact-label" title="@Text["Place"]">#</abbr></th><th scope="col">@Text["Player"]</th><th scope="col">@Text["Rank"]</th><th scope="col"><span class="wide-label">@Text["Kills"]</span><abbr class="compact-label" title="@Text["Kills"]">@Text["KillsShort"]</abbr></th><th scope="col"><span class="wide-label">@Text["Deaths"]</span><abbr class="compact-label" title="@Text["Deaths"]">@Text["DeathsShort"]</abbr></th></tr></thead>
                <tbody>
                    @foreach (var entry in _snapshot.Entries)
                    {
                        <tr>
                            <td class="leaderboard-place">@entry.Position</td>
                            <th scope="row">@entry.Name</th>
                            <td class="leaderboard-rank">
                                @PlayerRankDisplay.Name(Text, entry.Rank)
                                @if (PlayerRankDisplay.Progress(Text, entry.Rank, entry.Kills) is { } progress)
                                {
                                    <small class="leaderboard-rank-progress">@progress</small>
                                }
                            </td>
                            <td>@entry.Kills</td>
                            <td>@entry.Deaths</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (State is "fresh" or "stale")
        {
            <p class="leaderboard-empty">@Text["EmptyLeaderboard"]</p>
            <p>@Text["EmptyLeaderboardDetail"]</p>
        }
        else
        {
            <p class="leaderboard-empty">@Text["LeaderboardUnavailable"]</p>
            <p>@Text["LeaderboardUnavailableDetail"]</p>
        }
    </section>
    <p class="leaderboard-footnote">@Text["RankVsPosition"] <a class="leaderboard-rank-guide" href="@(Text.Link("/play") + "#ranks")">@Text["RankGuideLink"]</a></p>
    <p class="leaderboard-footnote">@Text["LeaderboardFootnoteBefore"] <code>/profile</code> @Text["InGame"]</p>
    <PlayerSearch Text="Text" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "lang")]
    private string? Language { get; set; }

    private PublicPageText Text => PublicPageText.For(Language);

    private PublicLeaderboardResponse? _snapshot;
    private double SnapshotAgeSeconds => _snapshot?.CapturedAtUtc is { } captured ? Math.Max(0, (DateTimeOffset.UtcNow - captured).TotalSeconds) : 0;
    private string State => _snapshot?.State is "fresh" or "stale" ? _snapshot.State : "unavailable";
    private string StateLabel => State switch
    {
        "fresh" => Text["Fresh"],
        "stale" => Text["Stale"],
        _ => Text["Unavailable"]
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapshot = await StatusClient.GetLeaderboardAsync();
            if (snapshot is { Entries.Count: <= 10 } &&
                (snapshot.State is not ("fresh" or "stale") || snapshot.CapturedAtUtc is not null))
            {
                _snapshot = snapshot;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or System.Text.Json.JsonException)
        {
            Logger.LogWarning("Unable to load the public leaderboard projection.");
        }
    }
}
