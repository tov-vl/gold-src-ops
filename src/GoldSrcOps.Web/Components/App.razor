<!DOCTYPE html>
<html lang="@DocumentLanguage">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="theme-color" content="#f4f5f0" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GoldSrcOps.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["public-join.js"]" defer></script>
    <script src="@Assets["public-leaderboard.js"]" defer></script>
    <script src="@Assets["public-play-status.js"]" defer></script>
    <script src="@Assets["public-status.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext Context { get; set; } = default!;

    private string DocumentLanguage => Context.Request.Path.Value is "/" or "/play" or "/leaderboard"
        ? PublicPageText.For(Context.Request.Query["lang"].FirstOrDefault()).Code : "en";
}
