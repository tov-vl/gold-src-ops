@using GoldSrcOps.Web.Hosting
@inject PublicPlayerSearchClient SearchClient
@inject PublicPlayerSearchOptions Options

@if (Options.Enabled)
{
    <section id="player-search" class="player-search" aria-labelledby="player-search-title"
             data-search-retry-seconds="@(_result?.State == "busy" ? _result.RetryAfterSeconds : null)"
             data-search-busy="@Text["SearchBusy"]" data-search-ready="@Text["SearchReady"]">
        <h2 id="player-search-title">@Text["SearchTitle"]</h2>
        <p id="player-search-hint">@Text["SearchHint"]</p>
        <EditForm id="player-search-form" Model="Model" FormName="player-search" OnSubmit="SearchAsync" method="post" action="@(Text.Link("/leaderboard") + "#player-search")" Enhance="false">
            <label for="player-search-match">@Text["SearchMode"]</label>
            <InputSelect id="player-search-match" @bind-Value="Model!.Match" aria-describedby="player-search-hint">
                <option value="exact">@Text["SearchExact"]</option>
                <option value="contains">@Text["SearchContains"]</option>
            </InputSelect>
            <label for="player-search-name">@Text["SearchName"]</label>
            <div class="player-search-controls">
                <InputText id="player-search-name" @bind-Value="Model!.Name" maxlength="31" required autocomplete="off" spellcheck="false" aria-describedby="player-search-hint player-search-message" />
                <button id="player-search-submit" type="submit">@Text["SearchSubmit"]</button>
            </div>
        </EditForm>
        <p id="player-search-message" class="player-search-message" role="status" data-search-state="@(_result?.State ?? "idle")">@Message</p>
        @if (_result is { State: "fresh", Entries.Count: 0 } && Model is { Match: "exact" } &&
             PublicPlayerSearchClient.TryNormalize(Model.Name, "contains", out _))
        {
            <button id="player-search-contains" type="submit" form="player-search-form"
                    name="Model.Action" value="contains" aria-describedby="player-search-message">@Text["SearchTryContains"]</button>
        }
        <p class="visually-hidden" role="status" aria-atomic="true" data-search-announcement></p>
        @if (_result is { State: "fresh", Entries.Count: > 0, CapturedAtUtc: { } captured })
        {
            <p class="player-search-capture">@Text["SearchSnapshot"] <time datetime="@captured.ToString("O")">@captured.ToUniversalTime().ToString("dd.MM.yyyy HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</time></p>
            <ol class="player-search-results" aria-label="@Text["SearchResults"]">
                @foreach (var entry in _result.Entries)
                {
                    <li class="player-search-result">
                        <h3>@entry.Name</h3>
                        <p class="player-search-rank">@PlayerRankDisplay.Name(Text, entry.Rank)</p>
                        <p class="player-search-progress">@PlayerRankDisplay.Progress(Text, entry.Rank, entry.Kills)</p>
                        <dl>
                            <div><dt>@Text["Kills"]</dt><dd>@entry.Kills</dd></div>
                            <div><dt>@Text["Deaths"]</dt><dd>@entry.Deaths</dd></div>
                        </dl>
                    </li>
                }
            </ol>
            @if (_result.HasMore)
            {
                <p class="player-search-notice">@Text[Model?.Match is "contains" ? "SearchMoreContains" : "SearchMore"]</p>
            }
            <p>@Text["SearchDuplicates"]</p>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public PublicPageText Text { get; set; } = null!;
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm(FormName = "player-search")] private SearchForm? Model { get; set; }
    private PublicPlayerSearchResponse? _result;

    private string Message => _result?.State switch
    {
        "fresh" when _result.Entries.Count == 0 => Text[Model?.Match is "contains" ? "SearchEmptyContains" : "SearchEmpty"],
        "fresh" => Text.Format("SearchFound", _result.Entries.Count),
        "busy" => Text.Format("SearchBusy", _result.RetryAfterSeconds ?? 10),
        "invalid" => Text[Model?.Match is "contains" ? "SearchInvalidContains" : "SearchInvalid"],
        "unavailable" => Text["SearchUnavailable"],
        _ => Text["SearchPrivacy"]
    };

    protected override void OnInitialized()
    {
        Model ??= new();
        // Older forms have no mode field; an explicitly empty or unknown value stays invalid.
        if (HttpContext?.Request.HasFormContentType == true && !HttpContext.Request.Form.ContainsKey("Model.Match"))
            Model.Match = "exact";
    }

    private async Task SearchAsync()
    {
        if (!Options.Enabled)
            return;
        if (Model is { Match: "exact", Action: "contains" })
            Model.Match = "contains";
        _result = await SearchClient.SearchAsync(Model?.Name, Model?.Match, HttpContext?.RequestAborted ?? CancellationToken.None);
        Model!.Name = PublicPlayerSearchClient.TryNormalize(Model.Name, out var name) ? name : string.Empty;
    }

    public sealed class SearchForm
    {
        public string Name { get; set; } = string.Empty;
        public string Match { get; set; } = "exact";
        public string? Action { get; set; }
    }
}
