<nav class="public-language" aria-label="@Text["Language"]">
    <a href="@Path" lang="ru" hreflang="ru" aria-current="@(Text.Code == "ru" ? "true" : null)">RU</a>
    <a href="@(Path + "?lang=en")" lang="en" hreflang="en" aria-current="@(Text.Code == "en" ? "true" : null)">EN</a>
</nav>

@code {
    [Parameter, EditorRequired]
    public string Path { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Language { get; set; } = "ru";

    private PublicPageText Text => PublicPageText.For(Language);
}
