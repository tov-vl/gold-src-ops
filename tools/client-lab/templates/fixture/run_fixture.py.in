"""One disposable HLDS instance from existing local inputs; no downloader or credentials."""
import socket
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tarfile
import time

import fixture_base as base
import steam_admission

PLUGIN = '{{PLUGIN_SHA256}}'
LAN_REJOIN = {{LAN_REJOIN}} == 1
STEAM_REJOIN = {{STEAM_REJOIN}} == 1
CONTINUITY = '{{CONTINUITY_SHA256}}'
DICTIONARY = '71b1ea3a49331e16e1383817849f04d702ee559c1be11c3e825172f0c5c939b7'
SDK = '47163830cbb9888e1a8162b7b5054c7118159ec05001059a9cf1d0fec466a43c'


def check(path, expected):
    if base.digest(path) != expected:
        raise RuntimeError('Pinned local input differs: ' + Path(path).name)


def vacant_info(reply, name):
    if not reply.startswith(b'\xff\xff\xff\xffI') or not 6 < len(reply) <= 4096:
        return False
    fields = reply[6:].split(b'\0', 4)
    if len(fields) != 5:
        return False
    server, map_name, folder, _, tail = fields
    return ((server, map_name, folder) == (name.encode('ascii'), b'de_dust2', b'cstrike')
            and len(tail) >= 9 and tail[0:2] == b'\x0a\0' and tail[2] == tail[4] == 0)


def fixture_is_vacant(name):
    query = b'\xff\xff\xff\xffTSource Engine Query\0'
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as udp:
            udp.settimeout(0.5)
            udp.connect(('127.0.0.1', 27025))
            udp.send(query)
            reply = udp.recv(4097)
            if reply.startswith(b'\xff\xff\xff\xffA') and len(reply) == 9:
                udp.send(query + reply[5:9])
                reply = udp.recv(4097)
            return vacant_info(reply, name)
    except OSError:
        return False


def main():
    evidence = Path('/evidence')
    if (evidence / 'runtime.json').exists():
        raise RuntimeError('A retained runtime result exists; do not reuse it')
    started = time.time()
    status = {'schema': 1, 'status': 'preparing', 'pluginSha256': PLUGIN.upper(),
              'dictionarySha256': DICTIONARY.upper(), 'runtimeVerified': False,
              'endpoint': '127.0.0.1:27025', 'name': '{{FIXTURE_NAME}}',
              'readinessEnabled': {{GUNS_READINESS}} == 1,
              'nativeSetupEnabled': {{GUNS_READINESS}} == 1,
              'setupCallback': 'gso_lab_ack' if {{GUNS_READINESS}} == 1 else None}
    def report():
        temporary = evidence / 'runtime.tmp'
        temporary.write_text(json.dumps(status, indent=2), encoding='utf-8')
        temporary.replace(evidence / 'runtime.json')
    report()
    server = None
    try:
        check('/sdk/steamclient.so', SDK)
        for name, expected in (
            ('amxmodx-1.10.0-git5481-base-linux.tar.gz', 'ee33b31ae92afd94802c43eae14ecdfa1ffa2ba0b11658e8bec98f48a5881272'),
            ('amxmodx-1.10.0-git5481-cstrike-linux.tar.gz', '76ff2bdd39f6dc14a2088ff4af724599c69a8ae7e3526679927aaef4ca898bf2'),
        ):
            check('/assets/' + name, expected)
        source = Path('/tmp/server-base')
        shutil.copytree('/opt/cs16/serverfiles-base', source, symlinks=False, ignore_dangling_symlinks=True)
        for origin, destination in (
            ('/runtime/rehlds/bin/linux32', source),
            ('/runtime/regamedll/bin/linux32/cstrike', source / 'cstrike'),
            ('/runtime/metamod/addons', source / 'cstrike/addons'),
            ('/runtime/reapi/addons', source / 'cstrike/addons'),
        ):
            shutil.copytree(origin, destination, dirs_exist_ok=True, symlinks=False)
        for name in ('amxmodx-1.10.0-git5481-base-linux.tar.gz', 'amxmodx-1.10.0-git5481-cstrike-linux.tar.gz'):
            with tarfile.open('/assets/' + name, 'r:gz') as archive:
                # Hash-pinned archives only; reject links and traversal on older Python versions.
                members = archive.getmembers()
                if any(m.issym() or m.islnk() or m.isdev() or Path(m.name).is_absolute() or '..' in Path(m.name).parts for m in members):
                    raise RuntimeError('Unsafe archive entry')
                archive.extractall(source / 'cstrike')
        shutil.copyfile('/sdk/steamclient.so', source / 'steamclient.so')
        checks = {
            'hlds_linux': '0209a150386194ae86e414623037088314ff5eb28fa62b423751ff2265a58608',
            'engine_i486.so': '5bb5d862b7e65ced8c9cc5a2159d52d5522e3eb784ba0eb88e6624a410566e99',
            'cstrike/dlls/cs.so': '9bb240044d842d996b73bdfb1cd1722247795f7e6f40f52b854e897c7e6426d4',
            'cstrike/addons/metamod/metamod_i386.so': '8bed09c362f6d9019ce7d88b9a19d1ad08eca26bf46c0ed32604fbea2d7ba7a9',
            'cstrike/addons/amxmodx/modules/reapi_amxx_i386.so': '2dad32476879dc64e734d81e386d4e3c14f039fc32c393ae2a2418d3a55650ec',
        }
        for path, expected in checks.items():
            check(source / path, expected)
        # Only the isolated container interface is wildcard-bound; no host port is published.
        base.HOST = '0.0.0.0'
        base.CONFIGS['cstrike/server.cfg'] = base.CONFIGS['cstrike/server.cfg'].replace('Isolated client acceptance', status['name'])
        base.CONFIGS['cstrike/server.cfg'] += 'mp_forcerespawn 1\nmp_respawn_immunitytime 2\nmp_respawn_immunity_force_unset 2\n'
        check('/inputs/fixture_vgui_guard.amxx', '{{GUARD_SHA256}}')
        base.CONFIGS['cstrike/server.cfg'] += 'gso_lab_readiness {{GUNS_READINESS}}\n'
        if LAN_REJOIN:
            base.CONFIGS['cstrike/server.cfg'] += 'gso_lab_guns_round_warmup 1\n'
        helper = 'cstrike/addons/amxmodx/plugins/fixture_vgui_guard.amxx'
        shutil.copyfile('/inputs/fixture_vgui_guard.amxx', source / helper)
        base.REQUIRED += (helper,)
        base.CONFIGS['cstrike/addons/amxmodx/configs/plugins.ini'] = 'fixture_vgui_guard.amxx\n' + base.CONFIGS['cstrike/addons/amxmodx/configs/plugins.ini']
        if LAN_REJOIN:
            continuity = 'cstrike/addons/amxmodx/plugins/fixture_continuity.amxx'
            check('/inputs/fixture_continuity.amxx', CONTINUITY)
            shutil.copyfile('/inputs/fixture_continuity.amxx', source / continuity)
            base.REQUIRED += (continuity,)
            base.CONFIGS['cstrike/addons/amxmodx/configs/plugins.ini'] += 'fixture_continuity.amxx\n'
            base.CONFIGS['cstrike/server.cfg'] += 'mp_round_infinite 0\nsv_timeout 12\n'
            module = 'cstrike/addons/amxmodx/modules/nvault_amxx_i386.so'
            check('/inputs/nvault_amxx_i386.so', 'e6a24a81b205410e9b5eb62ca3b1e2bb8f49a0480d5e84b177d7a57c512a0af6')
            shutil.copyfile('/inputs/nvault_amxx_i386.so', source / module)
            base.CONFIGS['cstrike/game_init.cfg'] = 'bot_enable 1\n'
            base.CONFIGS['cstrike/BotProfile.db'] = 'Default\n    Skill = 45\n    Aggression = 60\n    ReactionTime = 0.35\n    AttackDelay = 0\n    Difficulty = EASY+NORMAL+HARD+EXPERT\nEnd\nTemplate Lab\n    WeaponPreference = ak47\n    WeaponPreference = m4a1\n    WeaponPreference = deagle\nEnd\nLab LabAlpha\nEnd\nLab LabBravo\nEnd\n'
            base.CONFIGS['cstrike/server.cfg'] += (
                'bot_chatter off\nbot_join_after_player 0\nbot_quota_mode normal\n'
                'bot_quota 0\nbot_difficulty 0\nbot_stop 1\nmp_roundtime 1\n'
            )
            nav_path = source / 'cstrike/maps/de_dust2.nav'
            check('/inputs/de_dust2.nav', '9a44381363572f05d42fa4f82b293f54e49c93d60a4471d2fe8396ecceb77753')
            shutil.copyfile('/inputs/de_dust2.nav', nav_path)
            base.ASSET_SUFFIXES.add('.nav')
        if STEAM_REJOIN:
            observer = 'cstrike/addons/amxmodx/plugins/fixture_steam_observer.amxx'
            check('/inputs/fixture_steam_observer.amxx', '{{STEAM_OBSERVER_SHA256}}')
            shutil.copyfile('/inputs/fixture_steam_observer.amxx', source / observer)
            base.REQUIRED += (observer,)
            base.CONFIGS['cstrike/addons/amxmodx/configs/plugins.ini'] += 'fixture_steam_observer.amxx\n'
            base.CONFIGS['cstrike/server.cfg'] = base.CONFIGS['cstrike/server.cfg'].replace('sv_lan 1\n', 'sv_lan 0\ngso_lab_steam_admission 1\nsv_logrelay 0\n')
        fixture = Path('/tmp/fixture')
        manifest = base.prepare(source, fixture, '/inputs/goldsrcops.amxx', PLUGIN, '/inputs/goldsrcops.txt', DICTIONARY)
        private = Path('/tmp/private')
        private.mkdir(mode=0o700)
        def arguments(root):
            steam_args = ['-nomaster', '+sv_lan', '0'] if STEAM_REJOIN else []
            return ['timeout', '--signal=TERM', '--kill-after=5', '2400', str(Path(root) / 'hlds_linux'),
                    '-norestart', '-nobreakpad', '-insecure', *steam_args, '-game', 'cstrike', '-console', '-strictportbind',
                    '+ip', '0.0.0.0', '-port', '27025', '+map', 'de_dust2', '+servercfgfile', 'server.cfg', '-maxplayers', '4' if LAN_REJOIN else '2']
        base.launch_args = arguments
        # Drop only this container's process to the image's existing non-root steam identity.
        subprocess.run(['chown', '-R', 'steam:steam', '/tmp/fixture', '/tmp/private', '/evidence'], check=True)
        import pwd
        account = pwd.getpwnam('steam')
        os.setgroups([])
        os.setgid(account.pw_gid)
        os.setuid(account.pw_uid)
        server = base.LocalServer(fixture, private, PLUGIN, DICTIONARY)
        server.__enter__()
        server.process.stdin.write(b'goldsrcops_player_menu_status\ngoldsrcops_weapons_status\ngoldsrcops_stats_status\nmp_forcerespawn\nmp_respawn_immunitytime\nmp_respawn_immunity_force_unset\nstatus\n')
        server.process.stdin.flush()
        time.sleep(1)
        if STEAM_REJOIN:
            deadline = time.monotonic() + 75
            while time.monotonic() < deadline:
                log = server.read_private_log()
                if b'Connection to Steam servers successful.' in log:
                    break
                time.sleep(0.5)
            else:
                raise RuntimeError('Steam anonymous server logon was not confirmed')
            status['steamAnonymousLogon'] = True
        log = server.read_private_log()
        version = b'0.40.0' if LAN_REJOIN else b'0.39.0'
        if b'WEAPON_SELECTION_STATUS version=' + version + b' enabled=1 choices=3 pistol_choices=3 ' not in log:
            raise RuntimeError('Pinned addon did not report ready')
        if any(p.name.startswith('error_') for p in (fixture / 'cstrike/addons/amxmodx/logs').glob('*')):
            raise RuntimeError('AMXX error file exists')
        def is_vacant():
            if STEAM_REJOIN:
                return steam_admission.is_vacant(server, status['name'])
            return fixture_is_vacant(status['name'])

        if LAN_REJOIN and not is_vacant():
            raise RuntimeError('Rejoin requires a vacant fixture at start')
        if STEAM_REJOIN:
            status.update(steamRejoin=True, steamAdmissions=0, observerDisconnected=False)
        if LAN_REJOIN:
            status.update(lanRejoin=True, emptyAtStart=True)
        trial_log_offset = len(log)
        status.update(status='ready', runtimeVerified=True, uid=os.getuid(), files=len(manifest['files']),
                      maxRuntimeSeconds=2400, readyUnix=time.time(), fixtureManifestSha256=base.digest(fixture / 'fixture.json'))
        # Retain a bounded operator-only startup log, never a game account or production payload.
        (evidence / 'startup.log').write_bytes(log)
        report()
        print('Isolated fixture ready; no host port is published', flush=True)
        def request_stop(_signum, _frame):
            raise SystemExit(0)
        signal.signal(signal.SIGTERM, request_stop)
        trial_bots_added = False
        continuity_armed = False
        reconnect_window = None
        admitted = set()
        while time.time() - started < 2400:
            log = server.read_private_log()
            if not LAN_REJOIN:
                time.sleep(2)
                continue
            trial_log = log[trial_log_offset:]
            if STEAM_REJOIN:
                steam_admission.observe(server, trial_log, admitted, status, report)
            if not trial_bots_added and b'FIXTURE_GUNS_WARMUP phase=preview-closed' in trial_log:
                server.process.stdin.write(b'bot_quota 2\n')
                server.process.stdin.flush()
                trial_bots_added = True
                status['trialBotsAddedAfterPreviewClosed'] = True
                report()
            if (trial_bots_added and not continuity_armed
                    and b'FIXTURE_GUNS_CONTROL step=5 respawn=1 movement=1' in trial_log
                    and b'"LabAlpha<' in trial_log and b'"LabBravo<' in trial_log):
                if STEAM_REJOIN:
                    if len(admitted) != 1:
                        raise RuntimeError('First Steam approval required before arming')
                    steam_admission.console(server, b'gso_fixture_steam_observe_arm')
                server.process.stdin.write(b'gso_fixture_continuity_begin\n')
                server.process.stdin.flush()
                continuity_armed = True
                status['continuityRequested'] = True
                report()
            if continuity_armed:
                events = tuple(line.split(b'FIXTURE_CONTINUITY_', 1)[1]
                               for line in trial_log.splitlines() if b'FIXTURE_CONTINUITY_' in line)
                good_close = (b'CLIENT_CLOSE_ARMED observed=1', b'DISCONNECT observed=1')
                good_round = b'NEXT_ROUND spawn=1 selected=1'
                if (len(events) >= 6 and events[-2:] == good_close
                        and all(events.count(event) == 1 for event in (*good_close, good_round))
                        and reconnect_window is None):
                    reconnect_window = time.time() - 1.0
                    server.process.stdin.write(b'bot_quota 0\n')
                    server.process.stdin.flush()
                if (reconnect_window is not None and 'rejoinOpenedUnix' not in status
                        and time.time() - reconnect_window < 25 and is_vacant()):
                    status['rejoinOpenedUnix'] = reconnect_window
                    status['vacantForRejoin'] = True
                    report()
                if reconnect_window is not None and 'rejoinClosed' not in status:
                    if any(event.startswith((b'RECONNECT ', b'TIMEOUT ')) for event in events):
                        status['rejoinClosed'] = True
                        report()
            time.sleep(1)
        status['status'] = 'expired'
    except SystemExit:
        status['status'] = 'stopped'
    except BaseException as error:
        status.update(status='failed', errorType=type(error).__name__, detail=str(error)[:180])
        raise
    finally:
        if server is not None:
            server.close()
        report()


if __name__ == '__main__':
    main()
