Set-StrictMode -Version Latest

function Get-LabRendererHash([byte[]]$Bytes) {
    $hash=[Security.Cryptography.SHA256]::Create()
    try{return ([BitConverter]::ToString($hash.ComputeHash($Bytes))).Replace('-','').ToLowerInvariant()}
    finally{$hash.Dispose()}
}

function New-LabRendererUnknown([string]$Id,[string]$Reason,[bool]$Enabled=$false) {
    Assert-LabId $Id
    return @{schema=1;jobId=$Id;status='unconfirmed';reason=$Reason;probeEnabled=$Enabled;cleanupVerified=$false}
}

function Get-LabRendererPaths([string]$GameRoot) {
    foreach($directory in @($GameRoot,(Join-Path $GameRoot 'cstrike'))){
        $parent=Get-Item -LiteralPath $directory
        while($parent){
            if($parent.Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Linked renderer directory.'}
            $parent=$parent.Parent
        }
        foreach($name in @('qconsole.log','console.log')){Join-Path $directory $name}
    }
}

function New-LabRendererProbe($Policy,[string]$Id) {
    Assert-LabId $Id
    $probe=@{enabled=$false;reason='log_preflight_unavailable';paths=@()}
    try {
        $probe.paths=@(Get-LabRendererPaths $Policy.gameRoot)
        if(@($probe.paths).Count -ne 4){throw 'Unexpected renderer path set.'}
        foreach($path in $probe.paths){
            if(Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue){$probe.reason='preexisting_log_preserved';return $probe}
            if([IO.File]::Exists($path) -or [IO.Directory]::Exists($path)){throw 'Unexpected renderer path.'}
        }
        $probe.enabled=$true;$probe.reason='awaiting_client_output'
    } catch { }
    return $probe
}

function Add-LabRendererProgram([string]$Id,[string]$Program,[bool]$Enabled) {
    Assert-LabId $Id
    if(-not $Enabled){return $Program}
    $token=([guid]$Id).ToString('N')
    return ('echo GSO_RENDERER_BEGIN_'+$token+"`r`ngl_dump`r`necho GSO_RENDERER_END_"+$token+"`r`n"+$Program)
}

function Add-LabRendererLaunchArguments([string]$Arguments,[bool]$Enabled) {
    if(-not $Enabled){return $Arguments}
    if(-not $Arguments.StartsWith('-applaunch 10 -gl ') -or $Arguments.Contains('-condebug')){throw 'Renderer launch boundary differs.'}
    return $Arguments.Replace('-applaunch 10 -gl ','-applaunch 10 -gl -condebug ')
}

function ConvertFrom-LabRendererFrame([string]$Text,[string]$Id) {
    Assert-LabId $Id
    if($Text.Length -gt 16384 -or $Text -match '[^\x09\x0A\x0D\x20-\x7E]'){throw 'Renderer frame is not bounded ASCII.'}
    $token=([guid]$Id).ToString('N')
    $begin='GSO_RENDERER_BEGIN_'+$token;$end='GSO_RENDERER_END_'+$token
    if([regex]::Matches($Text,[regex]::Escape($begin)).Count -ne 1 -or [regex]::Matches($Text,[regex]::Escape($end)).Count -ne 1){throw 'Renderer markers are not unique.'}
    $lines=@($Text.Replace("`r`n","`n").Split("`n")|Where-Object {$_.Length})
    if($lines.Count -ge 4 -and $lines[-1] -cmatch ('\A(GL Extensions: [\x20-\x7E]*)'+[regex]::Escape($end)+'[ \t]*\z')){
        $extension=$Matches[1];$lines=@($lines[0..($lines.Count-2)])+@($extension,$end)
    }
    if($lines.Count -lt 5 -or $lines[0].TrimEnd([char[]]" `t") -cne ('GSO_RENDERER_BEGIN_'+$token) -or $lines[-1].TrimEnd([char[]]" `t") -cne ('GSO_RENDERER_END_'+$token)){throw 'Renderer frame identity differs.'}
    $values=@{}
    foreach($line in $lines[1..($lines.Count-2)]){
        if($line -cmatch '\AGL (Vendor|Renderer|Version): ([\x20-\x7E]{1,256})\z'){
            $key=$Matches[1]
            if($values.ContainsKey($key) -or [string]::IsNullOrWhiteSpace($Matches[2])){throw 'Duplicate or empty GL field.'}
            $values[$key]=$Matches[2]
        } elseif($line -cmatch '\AGL Extensions: [\x20-\x7E]*\z'){
            if($values.ContainsKey('Extensions')){throw 'Duplicate GL extension line.'};$values.Extensions=$true
        } else {throw 'Unexpected renderer output.'}
    }
    if(-not $values.ContainsKey('Vendor') -or -not $values.ContainsKey('Renderer') -or -not $values.ContainsKey('Version')){throw 'Incomplete GL identity.'}
    return @{backend='OpenGL';vendor=$values.Vendor;renderer=$values.Renderer;version=$values.Version}
}

function Get-LabRendererEvidence($Policy,$Result,$Probe,[DateTime]$LaunchUtc) {
    $unknown=New-LabRendererUnknown $Result.id $Probe.reason ([bool]$Probe.enabled)
    if(-not $Probe.enabled){return $unknown}
    try {
        Assert-LabInteractionOwner $Policy $Result
        $processes=@(Get-LabProcess $Policy ([int]$Result.gamePid))
        if($processes.Count -ne 1 -or $processes[0].StartTime.ToUniversalTime().ToString('o') -cne $Result.gameStartedUtc -or
            $processes[0].StartTime.ToUniversalTime() -lt $LaunchUtc){throw 'Renderer process identity differs.'}
        $command=@(Get-CimInstance -ClassName Win32_Process -Filter ('ProcessId='+$Result.gamePid) -Property ProcessId,CommandLine -OperationTimeoutSec 3)
        $config='gso_lan_'+([guid]$Result.id).ToString('N')+'.cfg'
        if($command.Count -ne 1 -or $command[0].ProcessId -ne $Result.gamePid -or $command[0].CommandLine.Length -gt 32KB -or
            $command[0].CommandLine -cnotmatch '(?:^|\s)-condebug(?:\s|$)' -or
            $command[0].CommandLine -cnotmatch ('(?:^|\s)\+exec\s+"?'+[regex]::Escape($config)+'"?(?:\s|$)')){throw 'Renderer process command differs.'}
        $files=@($Probe.paths|Where-Object {Test-Path -LiteralPath $_})
        if($files.Count -ne 1){throw 'Renderer log is missing or ambiguous.'}
        $file=Get-Item -LiteralPath $files[0]
        if($file.Attributes -band [IO.FileAttributes]::ReparsePoint -or $file.PSIsContainer -or $file.CreationTimeUtc -lt $LaunchUtc -or $file.Length -gt 4MB){throw 'Renderer log identity differs.'}
        $stream=New-Object IO.FileStream($file.FullName,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite))
        try {
            if($stream.Length -gt 4MB){throw 'Renderer log exceeds limit.'}
            $bytes=New-Object byte[] ([int]$stream.Length)
            $read=0
            while($read -lt $bytes.Length){$count=$stream.Read($bytes,$read,$bytes.Length-$read);if($count -eq 0){throw 'Renderer log shortened.'};$read+=$count}
        } finally {$stream.Dispose()}
        $text=[Text.Encoding]::GetEncoding(28591).GetString($bytes)
        $token=([guid]$Result.id).ToString('N')
        $begin='GSO_RENDERER_BEGIN_'+$token;$end='GSO_RENDERER_END_'+$token
        $lines=$text.Replace("`r`n","`n").Split("`n")
        $starts=@(0..($lines.Length-1)|Where-Object {$lines[$_].TrimEnd([char[]]" `t") -ceq $begin})
        $ends=@(0..($lines.Length-1)|Where-Object {$lines[$_].TrimEnd([char[]]" `t") -ceq $end -or $lines[$_] -cmatch ('\AGL Extensions: [\x20-\x7E]*'+[regex]::Escape($end)+'[ \t]*\z')})
        if($starts.Count -ne 1 -or $ends.Count -ne 1 -or $ends[0] -le $starts[0]){throw 'Renderer output boundary missing or repeated.'}
        $frame=($lines[$starts[0]..$ends[0]] -join "`n")+"`n"
        $Probe.logPath=$file.FullName
        $Probe.logCreatedUtc=$file.CreationTimeUtc.ToString('o')
        $Probe.frame=$frame
        $identity=ConvertFrom-LabRendererFrame $frame $Result.id
        $frameBytes=[Text.Encoding]::ASCII.GetBytes($frame)
        Assert-LabInteractionOwner $Policy $Result
        return @{schema=1;jobId=$Result.id;status='identified';reason='process_bound_gl_dump';probeEnabled=$true;cleanupVerified=$false;
            gamePid=$Result.gamePid;gameStartedUtc=$Result.gameStartedUtc;observedUtc=[DateTime]::UtcNow.ToString('o');
            identity=$identity;frameBase64=[Convert]::ToBase64String($frameBytes);frameSha256=(Get-LabRendererHash $frameBytes);frameBytes=$frameBytes.Length}
    } catch {$unknown.reason='client_output_not_proven';return $unknown}
}

function Remove-LabRendererLogs($Policy,$Result,$Probe,[DateTime]$LaunchUtc) {
    if(-not $Probe.enabled){return $true}
    $paths=@(Get-LabRendererPaths $Policy.gameRoot)
    if(($paths -join '|') -cne ($Probe.paths -join '|')){return $false}
    $found=@($paths|Where-Object {Test-Path -LiteralPath $_})
    if(-not $found.Count){return $true}
    if(-not $Result.cleanupVerified -or -not $Result.gamePid -or -not $Result.gameStartedUtc -or $found.Count -ne 1 -or -not $Probe.ContainsKey('logPath')){return $false}
    if(@(Get-LabProcess $Policy ([int]$Result.gamePid)).Count){return $false}
    $file=Get-Item -LiteralPath $found[0]
    if($file.Attributes -band [IO.FileAttributes]::ReparsePoint -or $file.PSIsContainer -or $file.CreationTimeUtc -lt $LaunchUtc -or $file.Length -gt 4MB -or
        $file.FullName -cne $Probe.logPath -or $file.CreationTimeUtc.ToString('o') -cne $Probe.logCreatedUtc){return $false}
    $text=[Text.Encoding]::GetEncoding(28591).GetString([IO.File]::ReadAllBytes($file.FullName)).Replace("`r`n","`n")
    if(-not $text.Contains($Probe.frame)){return $false}
    # Only the newly created fixed log of a confirmed, now-closed owned process.
    [IO.File]::Delete($file.FullName)
    return -not (Test-Path -LiteralPath $file.FullName)
}

function Test-LabRendererEvidence($Result,[string]$Id) {
    Assert-LabId $Id
    $report=$Result.rendererEvidence
    if($Result.id -cne $Id -or $report.schema -ne 1 -or $report.jobId -cne $Id -or $report.status -cne 'identified' -or
        $report.reason -cne 'process_bound_gl_dump' -or $report.probeEnabled -isnot [bool] -or -not $report.probeEnabled -or
        $report.cleanupVerified -isnot [bool] -or -not $report.cleanupVerified -or
        $report.gamePid -ne $Result.gamePid -or [int]$report.gamePid -le 0 -or $report.gameStartedUtc -cne $Result.gameStartedUtc -or
        $Result.cleanupVerified -isnot [bool] -or -not $Result.cleanupVerified){throw 'Unaccepted renderer evidence.'}
    $started=ConvertTo-LabUtc $report.gameStartedUtc;$observed=ConvertTo-LabUtc $report.observedUtc;$completed=ConvertTo-LabUtc $Result.completedUtc
    if($observed -lt $started -or $observed -gt $completed){throw 'Renderer observation time differs.'}
    if($report.frameBase64 -isnot [string] -or $report.frameBase64.Length -gt 21848 -or
        $report.frameSha256 -isnot [string] -or $report.frameSha256 -cnotmatch '\A[0-9a-f]{64}\z'){throw 'Renderer frame encoding differs.'}
    $bytes=[Convert]::FromBase64String($report.frameBase64)
    if($bytes.Length -gt 16384 -or $bytes.Length -ne $report.frameBytes -or @($bytes|Where-Object {$_ -gt 127}).Count -or (Get-LabRendererHash $bytes) -cne $report.frameSha256){throw 'Renderer frame hash differs.'}
    $identity=ConvertFrom-LabRendererFrame ([Text.Encoding]::ASCII.GetString($bytes)) $Id
    foreach($key in @('backend','vendor','renderer','version')){if($identity[$key] -cne $report.identity.$key){throw 'Renderer projection differs.'}}
    return $identity
}

function Get-LabRetainedRendererDiagnostics([string]$Root,$Policy) {
    $report=@{schema=1;status='unavailable';rendererAccepted=$false;files=@()}
    try{
        if(@(Get-Process -Name hl -ErrorAction SilentlyContinue).Count){$report.status='client_busy';return $report}
        $queue=Get-Item -LiteralPath (Join-Path $Root 'queue')
        if($queue.Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Linked diagnostic queue.'}
        $jobs=@(Get-ChildItem -LiteralPath $queue.FullName -Filter '*.json' -File)
        if($jobs.Count -gt 8){throw 'Diagnostic queue exceeds limit.'}
        $eligible=@()
        foreach($job in $jobs){
            Assert-LabId $job.BaseName
            $paths=Get-LabPaths $Root $job.BaseName
            $path=Join-Path $paths.result 'result.json'
            if(-not (Test-Path -LiteralPath $path)){continue}
            $parent=Get-Item -LiteralPath $path
            while($parent){if($parent.Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Linked diagnostic result.'};$parent=$(if($parent -is [IO.DirectoryInfo]){$parent.Parent}else{$parent.Directory})}
            $result=Read-LabJson $path
            if($result.PSObject.Properties['rendererEvidence'] -and $result.id -ceq $job.BaseName -and
                $result.PSObject.Properties['completedUtc'] -and $result.completedUtc -and $result.status -ceq 'uncertain_cleanup' -and
                $result.rendererEvidence.schema -eq 1 -and $result.rendererEvidence.jobId -ceq $result.id -and
                $result.rendererEvidence.probeEnabled -is [bool] -and $result.rendererEvidence.probeEnabled -and
                $result.rendererEvidence.status -ceq 'unconfirmed' -and $result.rendererEvidence.cleanupVerified -is [bool] -and
                -not $result.rendererEvidence.cleanupVerified){$eligible+=,$result}
        }
        if($eligible.Count -ne 1){$report.status=$(if($eligible.Count){'ambiguous'}else{'not_required'});return $report}
        $result=$eligible[0];$report.jobId=$result.id
        $started=ConvertTo-LabUtc $result.gameStartedUtc;$completed=ConvertTo-LabUtc $result.completedUtc
        if($completed -lt $started -or $completed -gt [DateTime]::UtcNow.AddSeconds(10)){throw 'Diagnostic result time differs.'}
        $token=([guid]$result.id).ToString('N')
        $paths=@(Get-LabRendererPaths $Policy.gameRoot)
        for($number=0;$number -lt $paths.Count;$number++){
            $summary=@{role=@('root-qconsole','root-console','mod-qconsole','mod-console')[$number];exists=$false;read=$false}
            $item=Get-Item -LiteralPath $paths[$number] -Force -ErrorAction SilentlyContinue
            if($item){
                $summary.exists=$true
                if($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $item.Length -gt 4MB -or
                    $item.CreationTimeUtc -lt $started -or $item.CreationTimeUtc -gt $completed -or $item.LastWriteTimeUtc -gt $completed.AddSeconds(2)){$summary.reason='unrelated_or_unsafe';$report.files+=,$summary;continue}
                $summary.bytes=$item.Length;$summary.createdUtc=$item.CreationTimeUtc.ToString('o');$summary.modifiedUtc=$item.LastWriteTimeUtc.ToString('o')
                $stream=[IO.File]::Open($item.FullName,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
                try{
                    if($stream.Length -gt 4MB){throw 'Diagnostic log exceeds limit.'}
                    $bytes=New-Object byte[] ([int]$stream.Length);$read=0
                    while($read -lt $bytes.Length){$count=$stream.Read($bytes,$read,$bytes.Length-$read);if(-not $count){throw 'Diagnostic log shortened.'};$read+=$count}
                }finally{$stream.Dispose()}
                $after=Get-Item -LiteralPath $item.FullName
                if($after.Length -ne $summary.bytes -or $after.CreationTimeUtc.ToString('o') -cne $summary.createdUtc -or $after.LastWriteTimeUtc.ToString('o') -cne $summary.modifiedUtc){throw 'Diagnostic log changed.'}
                $summary.sha256=Get-LabRendererHash $bytes
                $text=[Text.Encoding]::GetEncoding(28591).GetString($bytes)
                $summary.markerContextsBase64=@()
                $summary.markerLayout=@()
                foreach($marker in @(('GSO_RENDERER_BEGIN_'+$token),('GSO_RENDERER_END_'+$token))){
                    $matches=@([regex]::Matches($text,[regex]::Escape($marker)))
                    foreach($match in @($matches|Select-Object -First 2)){
                        $lineStart=$text.LastIndexOf("`n",$match.Index)+1
                        $lineEnd=$text.IndexOf("`n",$match.Index);if($lineEnd -lt 0){$lineEnd=$text.Length}
                        $prefix=$text.Substring($lineStart,$match.Index-$lineStart)
                        $kind=$(if(-not $prefix){'marker'}elseif($prefix.StartsWith('GL Extensions: ')){'extensions'}else{'other'})
                        $suffix=$text.Substring($match.Index+$match.Length,$lineEnd-$match.Index-$match.Length)
                        $white=$suffix -cmatch '\A[ \t\r]*\z'
                        $summary.markerLayout+=,('column='+($match.Index-$lineStart)+';lineBytes='+($lineEnd-$lineStart)+';prefix='+$kind+';suffixWhitespace='+$white)
                        $context=$match.Value+$(if($white){$suffix.Substring(0,[Math]::Min(16,$suffix.Length))}else{''})
                        $summary.markerContextsBase64+=,[Convert]::ToBase64String([Text.Encoding]::GetEncoding(28591).GetBytes($context))
                    }
                }
                $summary.glLinesBase64=@($text.Replace("`r`n","`n").Split("`n")|Where-Object {$_ -cmatch '\AGL (Vendor|Renderer|Version): [\x20-\x7E]{1,256}\z'}|Select-Object -First 3|ForEach-Object {[Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes($_))})
                $summary.read=$true
            }
            $report.files+=,$summary
        }
        $report.status='observed'
    }catch{$report.status='unavailable'}
    return $report
}

function Get-LabClientObservation($Policy) {
    $observation=[ordered]@{schema=1;utc=[DateTime]::UtcNow.ToString('o');query='unavailable';truncated=$false;workerUserMatches=$false;workerSessionMatches=$false;steam=@();game=@()}
    try {
        $observation.workerUserMatches=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value -ceq $Policy.gameUserSid
        $observation.workerSessionMatches=(Get-Process -Id $PID).SessionId -eq $Policy.gameSessionId
        $items=@(Get-CimInstance -ClassName Win32_Process -Filter "Name='steam.exe' OR Name='hl.exe'" -Property Name,ProcessId,SessionId,ExecutablePath -OperationTimeoutSec 3 | Select-Object -First 9)
        if ($items.Count -gt 8) { $observation.truncated=$true; return [pscustomobject]$observation }
        $steamCount=@($items|Where-Object {$_.Name -ieq 'steam.exe'}).Count
        foreach ($item in $items) {
            $path=$(if($item.Name -ieq 'steam.exe'){Join-Path $Policy.steamRoot 'steam.exe'}else{Join-Path $Policy.gameRoot 'hl.exe'})
            $ownerMatches=$null
            try {
                if ($item.Name -ine 'steam.exe' -or $steamCount -ne 1) { throw 'Owner query is not needed for a blocked preflight.' }
                $owner=Invoke-CimMethod -InputObject $item -MethodName GetOwnerSid -OperationTimeoutSec 5
                if ($owner.ReturnValue -eq 0 -and $owner.Sid) { $ownerMatches=$owner.Sid -ceq $Policy.gameUserSid }
            } catch { }
            $entry=[pscustomobject]@{pathMatches=([string]$item.ExecutablePath -ieq $path);ownerMatches=$ownerMatches;sessionMatches=($item.SessionId -eq $Policy.gameSessionId)}
            if ($item.Name -ieq 'steam.exe') { $observation.steam+=@($entry) } else { $observation.game+=@($entry) }
        }
        $observation.query='ok'
    } catch { $observation.query='unavailable' }
    # No names, SIDs, command lines, arbitrary process data or account identifiers leave this function.
    return [pscustomobject]$observation
}

function Get-LabClientReadiness($Observation) {
    $code='local_prerequisites_ready'
    if (-not $Observation.workerUserMatches) { $code='worker_user_mismatch' }
    elseif (-not $Observation.workerSessionMatches) { $code='worker_session_mismatch' }
    elseif ($Observation.truncated) { $code='process_snapshot_truncated' }
    elseif ($Observation.query -cne 'ok') { $code='process_query_unavailable' }
    elseif (@($Observation.game).Count) { $code='game_already_running' }
    elseif (-not @($Observation.steam).Count) { $code='steam_not_running' }
    elseif (@($Observation.steam).Count -ne 1) { $code='steam_process_ambiguous' }
    elseif (-not $Observation.steam[0].pathMatches) { $code='steam_path_mismatch' }
    elseif ($null -eq $Observation.steam[0].ownerMatches) { $code='steam_owner_unverified' }
    elseif (-not $Observation.steam[0].ownerMatches) { $code='steam_user_mismatch' }
    elseif (-not $Observation.steam[0].sessionMatches) { $code='steam_session_mismatch' }
    return [pscustomobject]@{schema=1;utc=$Observation.utc;code=$code;ready=($code -ceq 'local_prerequisites_ready');steamProcessCount=@($Observation.steam).Count;gameProcessCount=@($Observation.game).Count;accountLogin='not_proven';otherComputerUsage='unknown'}
}

function Get-LabLogCheckpoint([string]$SteamRoot) {
    $items=@()
    foreach ($name in @('gameprocess_log.txt','console_log.txt')) {
        $entry=[ordered]@{name=$name;state='absent';offset=0;createdUtc=$null}
        try {
            $directory=Join-Path $SteamRoot 'logs'
            $path=Join-Path $directory $name
            foreach ($part in @($SteamRoot,$directory)) {
                if ((Get-Item -LiteralPath $part).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Linked log directory.' }
            }
            if (Test-Path -LiteralPath $path) {
                $file=Get-Item -LiteralPath $path
                if ($file.Attributes -band [IO.FileAttributes]::ReparsePoint -or $file.Length -gt 64MB) { throw 'Unsupported log file.' }
                $entry.state='present';$entry.offset=$file.Length;$entry.createdUtc=$file.CreationTimeUtc.ToString('o')
            }
        } catch { $entry.state='unavailable' }
        $items+=@([pscustomobject]$entry)
    }
    return ,$items
}

function Get-LabSteamHints([string]$Text) {
    $hints=@()
    foreach ($line in @($Text -split '\r?\n' | Select-Object -First 256)) {
        if ($line.Length -gt 2048 -or $line -notmatch '(?i)\bApp(?:ID|\s+ID)?\s*[:=#]?\s*10\b') { continue }
        if ($line -match '(?i)\bapp already running\b|\bapplication already running\b') { $hints+='app10_already_running_hint' }
        if ($line -match '(?i)\bmissing executable\b') { $hints+='app10_missing_executable_hint' }
        if ($line -match '(?i)\bfailed to (?:start|launch)\b|\blaunch failed\b') { $hints+='app10_launch_failure_hint' }
    }
    return @($hints|Select-Object -Unique)
}

function Get-LabLogEvidence([string]$SteamRoot,$Checkpoint,[DateTime]$LaunchUtc) {
    if (@($Checkpoint).Count -ne 2 -or (@($Checkpoint.name|Sort-Object) -join '|') -cne 'console_log.txt|gameprocess_log.txt') { throw 'Invalid log checkpoint.' }
    $evidence=@()
    foreach ($baseline in $Checkpoint) {
        $entry=[ordered]@{source=$baseline.name;state='unavailable';bytesRead=0;truncated=$false;hints=@()}
        $stream=$null
        try {
            if ($baseline.state -notin @('absent','present')) { throw 'Log checkpoint unavailable.' }
            $directory=Join-Path $SteamRoot 'logs';$path=Join-Path $directory $baseline.name
            foreach ($part in @($SteamRoot,$directory,$path)) {
                if ((Get-Item -LiteralPath $part).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Linked log path.' }
            }
            $file=Get-Item -LiteralPath $path
            if ($file.Length -gt 64MB) { throw 'Unsupported log length.' }
            $offset=[long]$baseline.offset
            if (($baseline.state -ceq 'present' -and $file.CreationTimeUtc.ToString('o') -cne $baseline.createdUtc) -or
                $file.Length -lt $offset -or ($baseline.state -ceq 'absent' -and $file.CreationTimeUtc -lt $LaunchUtc.AddSeconds(-5))) {
                $entry.state='rotated_or_truncated';throw 'Log continuity unavailable.'
            }
            $stream=New-Object IO.FileStream($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))
            $end=$stream.Length
            if ($end -lt $offset) { $entry.state='rotated_or_truncated';throw 'Log shortened while opening.' }
            $count=[int][Math]::Min(16384,$end-$offset)
            $start=$end-$count
            $stream.Seek($start,[IO.SeekOrigin]::Begin)|Out-Null
            $bytes=New-Object byte[] $count
            $read=0
            while ($read -lt $count) {
                $n=$stream.Read($bytes,$read,$count-$read)
                if ($n -eq 0) { break };$read+=$n
            }
            $text=[Text.Encoding]::UTF8.GetString($bytes,0,$read)
            # Discard the first partial line when the byte window starts after the checkpoint.
            if ($start -gt $offset) {
                $newline=$text.IndexOf("`n");$text=$(if($newline -ge 0){$text.Substring($newline+1)}else{''})
            }
            $entry.state=$(if($read){'appended_window'}else{'no_new_bytes'})
            $entry.bytesRead=$read;$entry.truncated=$start -gt $offset
            $entry.hints=@(Get-LabSteamHints $text)
        } catch { }
        finally { if ($stream) { $stream.Dispose() } }
        $evidence+=@([pscustomobject]$entry)
    }
    # These are filtered local hints, never a diagnosis of account usage on another computer.
    return [pscustomobject]@{schema=1;hintsOnly=$true;rawTextRetained=$false;maxTotalBytes=32768;sources=$evidence}
}

function Set-LabLaunchOutcome($Result) {
    if ($Result.gamePid -and @($Result.images).Count -eq 2) {
        $Result.status='captured_unreviewed';$Result.failureCode=$null
    } elseif (-not $Result.gamePid) {
        $Result.status='uncertain_launch';$Result.failureCode='game_process_not_observed'
    } else {
        $Result.status='uncertain_capture'
        $Result.failureCode=$(if(@($Result.images).Count){'partial_capture'}else{'game_observed_no_frames'})
    }
}

function Invoke-LabDesktopDispatch([string]$Executable,[string]$Arguments,[string]$Directory) {
    $shell=$null;$windows=$null;$desktop=$null;$document=$null;$application=$null
    try {
        $shell=New-Object -ComObject Shell.Application
        $windows=$shell.Windows()
        $location=0;$rootLocation=0;$desktopHwnd=0
        $desktop=$windows.FindWindowSW([ref]$location,[ref]$rootLocation,8,[ref]$desktopHwnd,1)
        if(-not $desktop){throw 'Desktop shell is unavailable.'}
        $document=$desktop.Document
        $application=$document.Application
        if(-not $application){throw 'Desktop application is unavailable.'}
        $application.ShellExecute($Executable,$Arguments,$Directory,'open',1)
    } finally {
        foreach($item in @($application,$document,$desktop,$windows,$shell)) {
            if($null -ne $item -and [Runtime.InteropServices.Marshal]::IsComObject($item)) {
                try{[void][Runtime.InteropServices.Marshal]::ReleaseComObject($item)}catch{}
            }
        }
    }
}

function Assert-LabDesktopRequest([string]$Root,$Policy,[string]$Id) {
    if($Root -cne 'C:\ProgramData\GsoClientLab'){throw 'Unexpected desktop launch root.'}
    Assert-LabId $Id
    Assert-LabLease $Policy
    if([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -cne $Policy.gameUserSid -or
        (Get-Process -Id $PID).SessionId -ne $Policy.gameSessionId){throw 'Desktop launch identity differs.'}
    $paths=Get-LabPaths $Root $Id
    $job=Read-LabJson $paths.request
    Assert-LabRunnerJob $job
    if($job.id -cne $Id -or $job.action -cnotin @('verify-rules','verify-panel','capture-guns') -or -not (Get-LabAutonomousMode $Root $job)){throw 'Desktop launch requires a fixed autonomous panel job.'}
    $result=Read-LabJson (Join-Path $paths.result 'result.json')
    if($result.id -cne $Id -or $result.status -cne 'launch_claimed' -or -not $result.launchRequested){throw 'Desktop launch claim differs.'}
    $configName='gso_lan_'+([guid]$Id).ToString('N')+'.cfg'
    $configPath=Join-Path $Policy.gameRoot ('cstrike\'+$configName)
    foreach($path in @($Policy.gameRoot,(Join-Path $Policy.gameRoot 'cstrike'),$configPath)) {
        if((Get-Item -LiteralPath $path).Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Linked desktop launch input.'}
    }
    $rendererEnabled=$false
    if($result.PSObject.Properties.Name -contains 'rendererEvidence'){
        $renderer=$result.rendererEvidence
        if($renderer.schema -ne 1 -or $renderer.jobId -cne $Id -or $renderer.status -cne 'unconfirmed' -or $renderer.probeEnabled -isnot [bool]){throw 'Renderer launch claim differs.'}
        $rendererEnabled=$renderer.probeEnabled
    }
    $program=Add-LabRendererProgram $Id (New-LabRunnerInteractionProgram $job) $rendererEnabled
    if((Get-Item -LiteralPath $configPath).Length -gt 32KB -or [IO.File]::ReadAllText($configPath) -cne $program){throw 'Desktop launch program differs.'}
    if((Get-LabInteractionPanel $job) -ceq 'guns'){
        Assert-LabGunsBindings $Policy.gameRoot
    }
    Assert-LabInteractionBindings $Policy.gameRoot
    if(-not (Get-LabClientReadiness (Get-LabClientObservation $Policy)).ready){throw 'Desktop launch prerequisites differ.'}
    return @{job=$job;directory=$paths.result;arguments=(Add-LabRendererLaunchArguments (Get-LabRunnerLaunchArguments $job $configName) $rendererEnabled)}
}

function Invoke-LabDesktopChild([string]$Root,$Policy,[string]$Id) {
    $request=Assert-LabDesktopRequest $Root $Policy $Id
    $claim=Join-Path $request.directory 'shell-launch.claim'
    $stream=[IO.File]::Open($claim,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
    $stream.Dispose()
    $receipt=@{id=$Id;accepted=$false;stage='desktop_dispatch';automaticRetryAllowed=$false;utc=[DateTime]::UtcNow.ToString('o')}
    try {
        Invoke-LabDesktopDispatch (Join-Path $Policy.steamRoot 'steam.exe') $request.arguments $Policy.steamRoot
        $receipt.accepted=$true
        $receipt.stage='desktop_returned'
    } catch {$receipt.stage='desktop_failed'}
    Write-LabJson (Join-Path $request.directory 'shell-launch.json') $receipt
    if(-not $receipt.accepted){throw 'Desktop launch was not confirmed.'}
}

function Start-LabDesktopHelper([string]$Root,[string]$Id) {
    Assert-LabId $Id
    if($Root -cne 'C:\ProgramData\GsoClientLab'){throw 'Unexpected helper root.'}
    $executable=Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\powershell.exe'
    $arguments='-NoLogo -NoProfile -NonInteractive -STA -WindowStyle Hidden -File "'+$Root+'\code\Worker.ps1" -Root "'+$Root+'" -ShellJobId '+$Id
    return Start-Process -FilePath $executable -ArgumentList $arguments -WindowStyle Hidden -PassThru
}

function Confirm-LabDesktopHelper($Process,[string]$Directory,[string]$Id) {
    if(-not $Process.WaitForExit(20000)) {
        # Only the child process object created by this invocation is terminated.
        $Process.Kill()
        if(-not $Process.WaitForExit(5000)){throw 'Desktop helper cleanup was not confirmed.'}
        throw 'Desktop helper timed out; delivery is uncertain and will not be retried.'
    }
    if($Process.ExitCode -ne 0){throw 'Desktop helper failed; launch will not be retried.'}
    $receipt=Read-LabJson (Join-Path $Directory 'shell-launch.json') 2048
    if($receipt.id -cne $Id -or -not $receipt.accepted -or $receipt.stage -cne 'desktop_returned'){throw 'Desktop receipt differs.'}
}

function Find-LabDispatchedGame($Policy,$Result,[DateTime]$LaunchUtc,[string]$Id) {
    $clock=[Diagnostics.Stopwatch]::StartNew()
    do {
        $candidates=@(Get-LabProcess $Policy | Where-Object {$_.SessionId -eq $Policy.gameSessionId -and $_.StartTime.ToUniversalTime() -ge $LaunchUtc})
        if($candidates.Count -gt 1){throw 'Ambiguous dispatched game identity.'}
        if($candidates.Count -eq 1) {
            $candidate=$candidates[0]
            $items=@(Get-CimInstance -ClassName Win32_Process -Filter ('ProcessId='+$candidate.Id) -Property ProcessId,SessionId,ExecutablePath,CommandLine -OperationTimeoutSec 3)
            $token='gso_lan_'+([guid]$Id).ToString('N')+'.cfg'
            if($items.Count -ne 1 -or $items[0].ExecutablePath -ine (Join-Path $Policy.gameRoot 'hl.exe') -or
                $items[0].SessionId -ne $Policy.gameSessionId -or $items[0].CommandLine.Length -gt 32KB -or
                $items[0].CommandLine -cnotmatch ('(?:^|\s)\+exec\s+"?'+[regex]::Escape($token)+'"?(?:\s|$)')){throw 'Dispatched game command identity differs.'}
            $Result.gamePid=$candidate.Id
            $Result.gameStartedUtc=$candidate.StartTime.ToUniversalTime().ToString('o')
            Assert-LabInteractionOwner $Policy $Result
            return
        }
        Start-Sleep -Milliseconds 250
    } while($clock.Elapsed.TotalSeconds -lt 20)
    if(@(Get-LabProcess $Policy).Count){throw 'Unattributed game remains after desktop dispatch.'}
    $Result.cleanupVerified=$true
    $Result.cleanup.game='verified_no_game_after_reconciliation'
}
