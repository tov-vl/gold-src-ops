    {
      "id": 1,
      "type": "text",
      "title": "Границы наблюдения",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Обновление раз в минуту. Возраст считается от снимка источника; время успеха - от завершения чтения API. Пустой успешный снимок допустим. Предупреждения ждут пять минут; операторские пропуски допускаются до 15 минут. Отключенный рейтинг не создает предупреждений о данных. Личная доставка пока не настроена."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Монитор доступен",
      "datasource": {
        "type": "prometheus",
        "uid": "goldsrcops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет свежих данных",
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(goldsrcops_leaderboard:monitor_live)) and on() goldsrcops_leaderboard:monitor_live",
          "instant": true
        }
