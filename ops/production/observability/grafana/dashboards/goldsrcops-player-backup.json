{
  "id": null,
  "uid": "goldsrcops-player-backup",
  "title": "GoldSrcOps - Backup игровых данных",
  "description": "Private weekly player backup monitoring; no direct notification delivery.",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "Europe/Moscow",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "goldsrcops",
    "backup"
  ],
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Границы наблюдения",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Проверка раз в минуту. Backup: воскресенье, 04:00 МСК, только при пустом сервере. Возраст копии считается от capture; порог - восемь суток. Предупреждения видны здесь и в Prometheus. Личная доставка пока не настроена. Свежий журнал не подтверждает доступность off-host хранилища или восстановление движком."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Наблюдение",
      "datasource": {
        "type": "prometheus",
        "uid": "goldsrcops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Нет свежих данных",
          "unit": "",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Данные проверены",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Журнал недостоверен",
                  "color": "red",
                  "index": 1
                },
                "-1": {
                  "text": "Нет свежих данных",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(goldsrcops_player_backup_observation_success{job=\"goldsrcops\",service_name=\"goldsrcops-player-backup-monitor\"}) and goldsrcops_player_backup:monitor_live) or vector(-1)",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Возраст копии",
      "datasource": {
        "type": "prometheus",
