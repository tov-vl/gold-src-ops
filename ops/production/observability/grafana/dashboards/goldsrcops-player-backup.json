      "fieldConfig": {
        "defaults": {
          "noValue": "Нет свежих данных",
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 691201
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max(goldsrcops_player_backup_last_success_timestamp_seconds{job=\"goldsrcops\",service_name=\"goldsrcops-player-backup-monitor\"})) and (max(goldsrcops_player_backup_copy_present{job=\"goldsrcops\",service_name=\"goldsrcops-player-backup-monitor\"}) == 1) and goldsrcops_player_backup:observation_valid",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
