{
	admin off
	email {$GOLDSRCOPS_ACME_EMAIL}
}

(common) {
	encode zstd gzip

	header {
		-Server
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	log {
		output stdout
		format json
	}
}

{$GOLDSRCOPS_HOSTNAME} {
	import common
	reverse_proxy api:8080
}

{$GOLDSRCOPS_WEB_HOSTNAME} {
	import common
	reverse_proxy web:8080
}
