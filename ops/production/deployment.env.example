GOLDSRCOPS_IMAGE=ghcr.io/tov-vl/gold-src-ops@sha256:1111111111111111111111111111111111111111111111111111111111111111
GOLDSRCOPS_POSTGRES_IMAGE=postgres:16-alpine@sha256:2222222222222222222222222222222222222222222222222222222222222222
GOLDSRCOPS_CADDY_IMAGE=caddy:2-alpine@sha256:3333333333333333333333333333333333333333333333333333333333333333
GOLDSRCOPS_RESTIC_IMAGE=restic/restic:0.19.1@sha256:4444444444444444444444444444444444444444444444444444444444444444

GOLDSRCOPS_HOSTNAME=ops.example.com
GOLDSRCOPS_ACME_EMAIL=operator@example.com
GOLDSRCOPS_AUTHENTICATION_AUTHORITY=https://identity.example.com/realms/goldsrcops
GOLDSRCOPS_AUTHENTICATION_AUDIENCE=goldsrcops-api
GOLDSRCOPS_AUTHENTICATION_ROLE_CLAIM_TYPE=https://identity.example.com/claims/roles

GOLDSRCOPS_EDGE_SUBNET=172.31.246.0/24
GOLDSRCOPS_PROXY_IP=172.31.246.2
GOLDSRCOPS_API_IP=172.31.246.3

GOLDSRCOPS_POSTGRES_PASSWORD_FILE=/etc/goldsrcops/secrets/postgres-password
GOLDSRCOPS_DATABASE_CONNECTION_FILE=/etc/goldsrcops/secrets/database-connection
GOLDSRCOPS_RCON_SECRET_ALIAS=primary
GOLDSRCOPS_RCON_PASSWORD_FILE=/etc/goldsrcops/secrets/rcon-primary

GOLDSRCOPS_BACKUP_HOST=ops.example.com
GOLDSRCOPS_BACKUP_REPOSITORY=s3:https://object.example.com/goldsrcops/postgresql
GOLDSRCOPS_RESTIC_PASSWORD_FILE=/etc/goldsrcops/secrets/restic-password
GOLDSRCOPS_RESTIC_ENVIRONMENT_FILE=/etc/goldsrcops/secrets/restic-s3-environment
