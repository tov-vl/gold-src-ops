GOLDSRCOPS_ALERT_RECEIVER_IMAGE=ghcr.io/tov-vl/gold-src-ops-alert-receiver@sha256:1111111111111111111111111111111111111111111111111111111111111111
GOLDSRCOPS_ALERT_RECEIVER_POSTGRES_IMAGE=postgres:16-alpine@sha256:2222222222222222222222222222222222222222222222222222222222222222
GOLDSRCOPS_ALERT_RECEIVER_CADDY_IMAGE=caddy:2-alpine@sha256:3333333333333333333333333333333333333333333333333333333333333333
GOLDSRCOPS_RESTIC_IMAGE=restic/restic:0.19.1@sha256:4444444444444444444444444444444444444444444444444444444444444444

GOLDSRCOPS_ALERT_RECEIVER_HOSTNAME=receiver.example.com
GOLDSRCOPS_ALERT_RECEIVER_ACME_EMAIL=operator@example.com
GOLDSRCOPS_ALERT_RECEIVER_EDGE_SUBNET=172.31.248.0/24
GOLDSRCOPS_ALERT_RECEIVER_PROXY_IP=172.31.248.2
GOLDSRCOPS_ALERT_RECEIVER_IP=172.31.248.3
GOLDSRCOPS_ALERT_RECEIVER_EDGE_NETWORK=goldsrcops_edge

GOLDSRCOPS_ALERT_RECEIVER_POSTGRES_PASSWORD_FILE=/etc/goldsrcops-alert-receiver/secrets/postgres-password
GOLDSRCOPS_ALERT_RECEIVER_DATABASE_CONNECTION_FILE=/etc/goldsrcops-alert-receiver/secrets/database-connection
GOLDSRCOPS_ALERT_RECEIVER_AUTHORIZATION_FILE=/etc/goldsrcops-alert-receiver/secrets/receiver-authorization
GOLDSRCOPS_ALERT_RECEIVER_PROVIDER_ENDPOINT_FILE=/etc/goldsrcops-alert-receiver/secrets/provider-endpoint
GOLDSRCOPS_ALERT_RECEIVER_PROVIDER_AUTHORIZATION_FILE=/etc/goldsrcops-alert-receiver/secrets/provider-authorization
GOLDSRCOPS_PROVIDER_OPERATIONS_AUTHORIZATION_FILE=/etc/goldsrcops-provider-operations/authorization

GOLDSRCOPS_BACKUP_HOST=receiver.example.com
GOLDSRCOPS_BACKUP_REPOSITORY=s3:https://object.example.com/goldsrcops/alert-receiver-postgresql
GOLDSRCOPS_RESTIC_PASSWORD_FILE=/etc/goldsrcops-alert-receiver/secrets/restic-password
GOLDSRCOPS_RESTIC_ENVIRONMENT_FILE=/etc/goldsrcops-alert-receiver/secrets/restic-s3-environment
